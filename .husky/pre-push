#!/usr/bin/env sh
# pre-push: то же, что CI-джоб `checks` (lint → typecheck → translate:check → unit).
# Билд + tests/built (`pnpm verify:seo-build && pnpm test:built`) и Postgres-сьюты
# (`pnpm test:db`, нужен Docker) гоняет CI; локально — по необходимости, билд первым.
set -e

echo "▶ lint (eslint + prettier)"
pnpm lint

echo "▶ typecheck (astro check + tsc)"
pnpm typecheck

echo "▶ translate:check (RU/EN sync)"
pnpm translate:check

echo "▶ unit tests"
pnpm test

echo "✅ pre-push checks passed"
