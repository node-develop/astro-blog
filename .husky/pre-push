#!/usr/bin/env sh
# pre-push: полная проверка перед отправкой в remote.
# CI зеркалит lint+typecheck+test; запускаем те же шаги локально, чтобы push не валил CI.
set -e

echo "▶ lint (eslint + prettier)"
pnpm lint

echo "▶ typecheck (astro check + tsc)"
pnpm typecheck

echo "▶ translate:check (RU/EN sync)"
pnpm translate:check

echo "▶ vitest"
pnpm test

echo "▶ astro build"
pnpm build

echo "✅ pre-push checks passed"
