# Public site URL — used for canonical URLs, sitemap, RSS
SITE_URL=http://localhost:4321

# Postgres connection string (local docker-compose по умолчанию)
DATABASE_URL=postgres://blog:blog@localhost:5432/blog

# Better-Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4321

# GitHub OAuth (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap (только для первого запуска seed-скрипта)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Optional: Twitter/X handle for OpenGraph cards (with @)
PUBLIC_TWITTER_HANDLE=
