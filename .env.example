# Fallback base URL for Better-Auth when BETTER_AUTH_URL is unset (src/lib/auth.ts).
# NOT used for canonical URLs / sitemap / RSS — those come from CANONICAL_ORIGIN
# in src/lib/seo/url-policy.ts (and the SITE_URL build-arg in the Dockerfile).
SITE_URL=http://localhost:4321

# Postgres connection string (local docker-compose по умолчанию). REQUIRED in prod:
# docker-entrypoint.sh runs migrations + backfill against it on every start.
DATABASE_URL=postgres://blog:blog@localhost:5432/blog

# Better-Auth — both REQUIRED in prod; createAuth() throws without them
# (BETTER_AUTH_URL may fall back to SITE_URL). Generate the secret with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4321

# Where /admin/media writes uploads (src/lib/fs/paths.ts). Optional locally —
# defaults to public/uploads. The Docker image sets it to
# /app/dist/client/uploads; mount a persistent volume there in Dokploy
# (docs/runbooks/dokploy-uploads-volume.md).
# UPLOADS_DIR=

# GitHub OAuth (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap (только для первого запуска seed-скрипта)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Optional: Twitter/X handle for OpenGraph cards (with @); derived from person.sameAs when empty
PUBLIC_TWITTER_HANDLE=

# Optional: IndexNow key (8–128 chars [A-Za-z0-9-]); served at /<key>.txt, used by the publish ping
INDEXNOW_KEY=

# Anthropic API (RU→EN translation pipeline; required by both `pnpm translate`
# CLI and the in-admin `actions.translate.one` button).
ANTHROPIC_API_KEY=

# GitHub publish flow — fine-grained PAT scoped to the blog repo with
# "Contents: Read and write". Used by `actions.publish.one` to push admin
# edits straight to main without local git/SSH. The CI workflow then builds
# the Docker image and Dokploy redeploys (~2-3 min until live).
# https://github.com/settings/personal-access-tokens
GITHUB_PAT=
GITHUB_REPO_OWNER=node-develop
GITHUB_REPO_NAME=astro-blog
GITHUB_DEFAULT_BRANCH=main

# ── Social autopost (feature flag off by default) ─────────
SOCIAL_DRAFTS_ENABLED=false

# X / Twitter API v2 (OAuth 2.0 PKCE, populate via pnpm social:auth:x)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_TOKEN=
X_OAUTH_REFRESH=
X_HANDLE=

# LinkedIn (OAuth 2.0, populate via pnpm social:auth:linkedin)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# Telegram bot (created manually; bot must be channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional: comma-separated proxy IPs/CIDRs between the internet and the app
# (e.g. Cloudflare ranges) so Better-Auth rate limiting resolves the real
# client IP from X-Forwarded-For. Leave empty for a single Traefik hop.
AUTH_TRUSTED_PROXIES=
# External article ingestion API: persistent images and publication worker.
# API agent tokens are created with pnpm content:key; do not put them here.
CONTENT_WORKER_SECRET=
CONTENT_S3_ENDPOINT=
CONTENT_S3_REGION=auto
CONTENT_S3_BUCKET=
CONTENT_S3_ACCESS_KEY_ID=
CONTENT_S3_SECRET_ACCESS_KEY=
CONTENT_S3_PUBLIC_URL=
CONTENT_S3_FORCE_PATH_STYLE=false
