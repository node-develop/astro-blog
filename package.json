{
  "name": "astro-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "content:key": "tsx scripts/content-api-key.ts",
    "content:worker": "node --env-file=.env scripts/content-worker.mjs",
    "content:smoke": "tsx scripts/content-api-smoke.ts",
    "start": "astro dev",
    "prebuild": "rm -f public/pagefind",
    "build": "astro build --force && pnpm pagefind:rebuild",
    "pagefind:rebuild": "pagefind --site dist/client --output-subdir pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:built": "vitest run --project built",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "verify:seo-build": "tsx scripts/verify-seo-build.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/lib/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backfill": "tsx scripts/backfill-posts-meta.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:backfill-search": "tsx scripts/backfill-search-vector.ts",
    "translate": "tsx scripts/translate.ts",
    "translate:check": "tsx scripts/translate-check.ts",
    "social:auth:x": "tsx scripts/social-auth-x.ts",
    "social:auth:linkedin": "tsx scripts/social-auth-linkedin.ts",
    "social:recover": "tsx scripts/social-recover.ts",
    "social:smoke": "tsx scripts/social-smoke.ts",
    "voice:draft": "tsx scripts/voice-draft.ts",
    "assets:avatar": "tsx scripts/generate-avatar.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,astro}": [
      "eslint --fix --no-warn-ignored --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@octokit/rest": "^22.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "better-auth": "^1.7.5",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prettier": "^3.9.8",
    "probe-image-size": "^7.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-titles": "^1.2.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satori": "^0.33.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "zod": "^4.6.5",
    "@aws-sdk/client-s3": "^3.1136.0",
    "sharp": "^0.35.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/diff": "^8.0.0",
    "@types/hast": "3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/ui": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
