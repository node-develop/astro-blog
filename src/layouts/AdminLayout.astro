---
import "~/styles/global.css";
import "~/styles/admin.css";
import AdminHeader from "~/components/admin/AdminHeader.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Same no-flash bootstrap as BaseLayout: the admin honours the theme
         chosen on the public site, so switching there does not strand this
         page in paper. Values are 'paper' | 'dark', matching ThemeToggle. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("artka-theme");
          var prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "paper");
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {
          /* localStorage blocked */
        }
      })();
    </script>
  </head>
  <body>
    <AdminHeader />
    <main id="main" class="admin-main">
      <slot />
    </main>
    <style>
      .admin-main {
        max-width: 1080px;
        margin: 0 auto;
        padding: var(--space-6) var(--space-5);
      }
    </style>
  </body>
</html>
