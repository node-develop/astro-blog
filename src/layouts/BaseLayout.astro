---
import "~/styles/global.css";
import "katex/dist/katex.min.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Personal blog", ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <ClientRouter />
  </head>
  <body class="mx-auto max-w-3xl px-4 py-8 font-sans">
    <header class="mb-8 flex items-center justify-between">
      <a href="/" class="hover:text-brand-500 text-xl font-bold">Blog</a>
      <nav class="flex gap-4 text-sm">
        <a href="/blog" class="hover:underline">Статьи</a>
        <a href="/about" class="hover:underline">Обо мне</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer
      class="mt-16 border-t border-slate-200 pt-6 text-sm text-slate-500 dark:border-slate-800"
    >
      <p>© {new Date().getFullYear()} — Powered by Astro</p>
    </footer>
  </body>
</html>
