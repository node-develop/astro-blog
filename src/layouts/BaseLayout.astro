---
/**
 * Phase 5 audit fix — REPLACEMENT for src/layouts/BaseLayout.astro.
 *
 * Diff vs. previous (everything else identical):
 *   1. Description default: "Personal blog" → richer fallback that won't
 *      show on real pages (every page sets its own) but is sane in case.
 *   2. Favicon: SVG light + SVG dark via media query, .ico legacy
 *      fallback, apple-touch-icon as PNG (was incorrectly pointing at
 *      .svg — Safari iOS doesn't support svg apple-touch-icon).
 *   3. theme-color: light + dark variants via media-query <meta>.
 *   4. <link rel="manifest" href="/site.webmanifest"> for PWA install.
 *   5. <link rel="mask-icon"> for Safari pinned tabs.
 *   6. og:image fallback: PNG version of og-default if the request is
 *      from a known SVG-hostile crawler (Twitter cards historically
 *      didn't render SVG well — we ship both, prefer PNG via og:image
 *      and keep SVG as og:image:secure).
 *
 * The fonts/maskable PNG referenced here are documented in
 * phase-5/public/FAVICON-RASTER-README.md — generate them locally
 * from the shipped SVGs before deploying.
 */
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import MobileDrawer from "~/components/MobileDrawer.astro";
import SkipLink from "~/components/SkipLink.astro";
import Search from "~/components/Search.astro";
import Analytics from "~/components/Analytics.astro";
import { t } from "~/i18n";
import { getLocaleFromPath, getCounterpart, checkCounterpartExists } from "~/lib/i18n/routing";
import { buildGraph, safeJsonLd, type GraphNode } from "~/lib/seo/schema";
import { person } from "~/lib/seo/person";
import { canonicalPath, canonicalUrl } from "~/lib/seo/url-policy";
import { twitterHandleFromSameAs } from "~/lib/seo/social";
// Hashed URLs of the primary serif subsets. Vite dedupes by content, so these
// resolve to the exact files @fontsource's CSS references — preloading them
// takes the H1 web-font off the CSS critical path. Latin + Cyrillic only:
// the other subsets (greek, vietnamese, *-ext) are never used above the fold.
import serifLatinUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import serifCyrillicUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-cyrillic-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string | undefined;
  ogImageWidth?: number | undefined;
  ogImageHeight?: number | undefined;
  ogType?: "website" | "article";
  noindex?: boolean;
  fullWidth?: boolean;
  /** Drop the left sidebar column entirely (home page editorial layout). */
  noSidebar?: boolean;
  extraSchemaNodes?: ReadonlyArray<GraphNode | null>;
}

const {
  title,
  description = "Записки из продакшна — backend, AI agent engineering, distributed systems.",
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = "website",
  noindex = false,
  fullWidth = false,
  noSidebar = false,
  extraSchemaNodes = [],
} = Astro.props;

// Brand suffix — every <title> ends with " | artka.dev" unless it already
// contains the brand. Pages don't have to remember to append it themselves.
const BRAND = "artka.dev";
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;

const locale = getLocaleFromPath(Astro.url.pathname);
const canonical = canonicalUrl(Astro.url.pathname);

const counterpartPath = getCounterpart(Astro.url.pathname, locale);
const counterpartExists = await checkCounterpartExists(Astro.url.pathname, locale);
const ruVariant = locale === "ru" ? canonical : canonicalUrl(counterpartPath);
const enVariant = locale === "en" ? canonical : canonicalUrl(counterpartPath);

const ogLocale = locale === "ru" ? "ru_RU" : "en_US";
const ogLocaleAlternate = locale === "ru" ? "en_US" : "ru_RU";

// OG image: always PNG raster. SVG fallback used to live on og:image:secure_url
// but Twitter/Facebook reject SVG previews — see SEO audit 2026-05-08, claim #10.
const absoluteOgImage = ogImage
  ? /^https?:\/\//.test(ogImage)
    ? ogImage
    : new URL(ogImage, Astro.site ?? Astro.url).toString()
  : new URL("/og-default.png", Astro.site ?? Astro.url).toString();

// Explicit env override wins; otherwise derive the handle from the X profile
// listed in person.sameAs so cards attribute correctly without extra config.
const twitterHandle =
  import.meta.env.PUBLIC_TWITTER_HANDLE || twitterHandleFromSameAs(person.sameAs) || undefined;
const imageAlt = ogImageAlt ?? fullTitle;
// Preload only the subsets this locale paints first: Cyrillic for RU pages,
// Latin for both (brand, code, EN copy).
const fontPreloads = locale === "ru" ? [serifCyrillicUrl, serifLatinUrl] : [serifLatinUrl];
const rssHref = locale === "ru" ? "/rss.xml" : "/en/rss.xml";
const jsonFeedHref = locale === "ru" ? "/feed.json" : "/en/feed.json";

const localePrefix = locale === "en" ? "/en" : "";
const footerLinks = {
  about: [
    { href: canonicalPath(`${localePrefix}/about`), key: "nav.about" },
    { href: canonicalPath(`${localePrefix}/contact`), key: "nav.contact" },
    { href: canonicalPath(`${localePrefix}/privacy`), key: "nav.privacy" },
    { href: canonicalPath(`${localePrefix}/now`), key: "nav.now" },
    { href: canonicalPath(`${localePrefix}/uses`), key: "nav.uses" },
    { href: canonicalPath(`${localePrefix}/projects`), key: "nav.projects" },
  ],
  read: [
    { href: canonicalPath(`${localePrefix}/blog`), key: "nav.posts" },
    {
      href: canonicalPath(`${localePrefix}/courses/claude-code-guide`),
      key: "footer.link.course",
    },
    { href: canonicalPath(`${localePrefix}/tags`), key: "footer.link.tags" },
    { href: rssHref, key: "footer.link.rss" },
    { href: jsonFeedHref, key: "footer.link.json" },
  ],
} as const;

const socialLabel = (url: string): string => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host.endsWith("github.com")) return "GitHub";
  if (host.endsWith("linkedin.com")) return "LinkedIn";
  if (host === "x.com" || host === "twitter.com") return "X";
  if (host === "t.me" || host === "telegram.me") return "Telegram";
  if (host.includes("mastodon")) return "Mastodon";
  return host;
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      fontPreloads.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
      ))
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("artka-theme");
          var prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "paper");
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {
          /* localStorage blocked */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {
      counterpartExists && (
        <>
          <link rel="alternate" hreflang="ru-RU" href={ruVariant} />
          <link rel="alternate" hreflang="en-US" href={enVariant} />
          <link rel="alternate" hreflang="x-default" href={ruVariant} />
        </>
      )
    }

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {counterpartExists && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="artka.dev" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={String(ogImageWidth ?? 1200)} />
    <meta property="og:image:height" content={String(ogImageHeight ?? 630)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    <!-- Favicon set -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/favicon.svg" color="#9C5A2A" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- theme-color: split light/dark so iOS Safari address bar matches -->
    <meta name="theme-color" content="#FAF8F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1814" media="(prefers-color-scheme: dark)" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(locale, "site.feedTitle")}
      href={rssHref}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={t(locale, "site.feedTitle")}
      href={jsonFeedHref}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd(buildGraph({ locale, extraNodes: extraSchemaNodes }))}
    />
    <Analytics domain="artka.dev" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body data-auth="signed-out">
    <SkipLink />
    <Header />
    <!--
      MobileDrawer is self-contained: it carries its own primary nav and does
      not declare a <slot/> for children, so any nested content is dropped by
      Astro at render time. The drawer is intentionally separate from the
      desktop sidebar to keep mobile navigation editorial-clean.
    -->
    <MobileDrawer />
    <div class="layout" data-full-width={fullWidth} data-no-sidebar={noSidebar}>
      {
        !noSidebar && (
          <aside class="layout__sidebar" aria-label={t(locale, "sidebar.aria")}>
            <slot name="sidebar" />
          </aside>
        )
      }
      <main id="main" class="layout__main">
        <slot />
      </main>
      <aside class="layout__toc" aria-label={t(locale, "post.tocAria")}>
        <slot name="toc" />
      </aside>
    </div>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav class="site-footer__cols" aria-label="Footer">
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.about")}</h2>
            <ul>
              {
                footerLinks.about.map((l) => (
                  <li>
                    <a href={l.href}>{t(locale, l.key)}</a>
                  </li>
                ))
              }
            </ul>
          </section>
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.read")}</h2>
            <ul>
              {
                footerLinks.read.map((l) => (
                  <li>
                    <a href={l.href}>{t(locale, l.key)}</a>
                  </li>
                ))
              }
            </ul>
          </section>
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.connect")}</h2>
            <ul>
              {
                person.sameAs.map((url) => (
                  <li>
                    <a href={url} rel="me noopener" target="_blank">
                      {socialLabel(url)}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href={`mailto:${person.email}`} rel="me">{t(locale, "footer.link.email")}</a>
              </li>
            </ul>
          </section>
        </nav>
      </div>
    </footer>

    <Search />

    <style>
      .layout {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-6) var(--space-5);
        display: grid;
        grid-template-columns: var(--col-sidebar) minmax(0, 1fr) var(--col-toc);
        gap: var(--gutter);
      }
      .layout[data-full-width="true"] {
        grid-template-columns: var(--col-sidebar) minmax(0, 1fr);
      }
      .layout[data-full-width="true"] .layout__toc {
        display: none;
      }
      /* noSidebar alone keeps the toc rail (articles); combined with
         fullWidth it collapses to a single centered column. */
      .layout[data-no-sidebar="true"] {
        grid-template-columns: minmax(0, 1fr) var(--col-toc);
      }
      .layout[data-full-width="true"][data-no-sidebar="true"] {
        grid-template-columns: minmax(0, 1fr);
      }
      .layout__sidebar,
      .layout__toc {
        position: sticky;
        top: var(--space-5);
        align-self: start;
        max-height: calc(100vh - var(--space-6));
        overflow-y: auto;
      }
      .layout__main {
        min-width: 0;
      }
      @media (max-width: 1023px) {
        /* data-no-sidebar must be listed explicitly: its desktop rule has
           higher specificity (0,2,0) than bare .layout and would otherwise
           keep the phantom toc track on phones. */
        .layout,
        .layout[data-full-width="true"],
        .layout[data-no-sidebar="true"] {
          grid-template-columns: minmax(0, 1fr);
        }
        .layout__sidebar,
        .layout__toc {
          display: none;
        }
      }
      @media (max-width: 768px) {
        .layout {
          padding: var(--space-4) var(--space-4);
        }
      }
      @media (max-width: 414px) {
        .layout {
          padding: var(--space-3) var(--space-3);
        }
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-6);
      }
      .site-footer__inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-5);
        font-size: var(--fs-sm);
        color: var(--color-fg-muted);
      }
      .site-footer__cols {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-5);
      }
      .site-footer__col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .site-footer__col li a {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        overflow-wrap: anywhere;
        color: var(--color-fg-muted);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: color var(--dur-fast) var(--ease-out);
      }
      .site-footer__col li a:hover {
        color: var(--color-accent);
        border-bottom-color: var(--color-accent);
      }
      .site-footer__heading {
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--color-fg-subtle);
        font-weight: 500;
        margin: 0 0 var(--space-2);
      }
      @media (max-width: 767px) {
        .site-footer__inner {
          padding: var(--space-4);
        }
        .site-footer__cols {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: var(--space-4);
        }
        .site-footer__col:last-child {
          grid-column: 1 / -1;
        }
        .site-footer__col:last-child ul {
          flex-direction: row;
          flex-wrap: wrap;
          column-gap: var(--space-4);
        }
      }
    </style>

    <!--
      Auth signal for client-side widgets that need to know whether the
      user is signed in (e.g. CertificateButton, course progress sync).
      The Better-Auth middleware should set body[data-auth="signed-in"]
      when a session is active. This is a tiny island — replace with
      your own equivalent if you wire it in differently.
    -->
    <script>
      // Auth probe is deferred to idle so it never competes with FCP/TTI.
      // Anonymous visitors pay a wasted request otherwise. UI islands that
      // gate on body[data-auth="signed-in"] (CertificateButton, course
      // progress) should render a skeleton until the attribute appears,
      // not assume it's there on first paint.
      const probeAuth = async () => {
        try {
          const r = await fetch("/api/auth/get-session/", { credentials: "same-origin" });
          if (r.ok) {
            const data = await r.json();
            if (data?.user) document.body.setAttribute("data-auth", "signed-in");
          }
        } catch {
          /* anonymous */
        }
      };
      if (typeof window.requestIdleCallback === "function") {
        window.requestIdleCallback(probeAuth, { timeout: 2000 });
      } else {
        // Safari < 17 fallback. setTimeout(0) yields after the current task.
        setTimeout(probeAuth, 0);
      }
    </script>
  </body>
</html>
