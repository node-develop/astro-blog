---
import BaseLayout from "./BaseLayout.astro";
import PostTOC from "~/components/PostTOC.astro";
import SiteSidebar from "~/components/SiteSidebar.astro";
import AuthorCard from "~/components/AuthorCard.astro";
import ReadingProgress from "~/components/ReadingProgress.astro";
import PrevNext from "~/components/PrevNext.astro";
import RelatedPosts from "~/components/RelatedPosts.astro";
import Newsletter from "~/components/Newsletter.astro";
import Comments from "~/components/Comments.astro";
import { renderInlineCode } from "~/lib/inline-md";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import { resolveTagLabel } from "~/lib/content/tags";
import tagsRu from "~/i18n/tags.ru.json";
import tagsEn from "~/i18n/tags.en.json";
import Tldr from "~/components/mdx/Tldr.astro";
import Faq from "~/components/mdx/Faq.astro";
import {
  buildBlogPostingNode,
  buildBreadcrumbListNode,
  buildFaqPageNode,
  extractArticleBody,
  type GraphNode,
} from "~/lib/seo/schema";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

interface Props {
  post: CollectionEntry<"posts">;
  headings: readonly MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, summary, faq } = post.data;
const locale = getLocaleFromPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const slug = post.id.replace(/^en\//, "");
const ogImagePath = `/og/${slug}.png`;

// Cover is stored as a path relative to /uploads/ (e.g. "2026/04/file.png").
// Accept both bare relatives and pre-prefixed absolutes for forward compatibility.
const coverUrl = cover
  ? cover.startsWith("/") || /^https?:\/\//.test(cover)
    ? cover
    : `/uploads/${cover}`
  : null;
const readingTime = estimateReadingTimeMinutes(post.body ?? "");

function estimateReadingTimeMinutes(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
}

const siteBase = Astro.site?.toString() ?? "https://artka.dev";
const absoluteCover = coverUrl
  ? /^https?:\/\//.test(coverUrl)
    ? coverUrl
    : new URL(coverUrl, siteBase).toString()
  : new URL("/og-default.svg", siteBase).toString();

const excerpt = extractArticleBody(post.body ?? "", 800);

const blogPostingNode = buildBlogPostingNode({
  locale,
  canonical,
  title,
  description,
  pubDate,
  updatedDate: updatedDate ?? null,
  image: absoluteCover,
  keywords: tags,
  articleBody: excerpt.text,
  wordCount: excerpt.fullWordCount,
}) as GraphNode;

const breadcrumbNode = buildBreadcrumbListNode({
  locale,
  blogIndexLabel: t(locale, "blog.title"),
  title,
}) as GraphNode;

const faqItems = faq ?? [];
const faqNode = buildFaqPageNode({ canonical, items: faqItems });

const tagDict = (locale === "en" ? tagsEn : tagsRu) as Record<string, string>;
const tagsHrefBase = locale === "en" ? "/en/tags/" : "/tags/";

const primaryTag = tags?.[0] ?? "—";
const pubYear = pubDate.getFullYear();
const pagefindFilter = `tag:${primaryTag}, date:${pubYear}, lang:${locale}`;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImagePath}
  ogType="article"
  extraSchemaNodes={[blogPostingNode, breadcrumbNode, faqNode]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={post.data.author} />
    {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <SiteSidebar slot="sidebar" activeSlug={post.id} />
  <PostTOC slot="toc" headings={headings} />

  <ReadingProgress targetSelector=".post" />

  <article
    class="post"
    data-pagefind-body
    data-pagefind-filter={pagefindFilter}
    data-pagefind-meta={`title:${title}`}
  >
    <header class="post__header">
      <p class="post__eyebrow">
        <time datetime={pubDate.toISOString()}>
          {
            pubDate.toLocaleDateString(locale === "ru" ? "ru-RU" : "en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} {t(locale, "post.minutes")}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t(locale, "post.updated").toLowerCase()}{" "}
                {updatedDate.toLocaleDateString(locale === "ru" ? "ru-RU" : "en-US")}
              </span>
            </>
          )
        }
      </p>
      <h1 class="post__title">{title}</h1>
      {description && <p class="post__lede" set:html={renderInlineCode(description)} />}
      {
        tags.length > 0 && (
          <ul class="post__tags" aria-label={t(locale, "post.tags")}>
            {tags.map((tag: string) => (
              <li>
                <a class="post__tag-chip" href={`${tagsHrefBase}${tag}`}>
                  #{resolveTagLabel(tag, locale, tagDict)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      coverUrl && (
        <figure class="post__cover">
          <img src={coverUrl} alt={coverAlt ?? ""} loading="eager" decoding="async" />
        </figure>
      )
    }
    {summary && <Tldr text={summary} />}
    <div class="post__body prose">
      <slot />
    </div>
    {faqItems.length > 0 && <Faq items={faqItems} />}
    <PrevNext currentSlug={slug} locale={locale} />
    <AuthorCard />
  </article>

  <aside class="post__after">
    <RelatedPosts currentSlug={slug} locale={locale} />
    <Newsletter />
    <Comments />
  </aside>

  <script>
    import { enhanceCodeBlocks } from "~/lib/enhance-code-blocks";
    import { initSideNotes } from "~/lib/posts/side-notes";

    // astro:page-load fires on initial mount and after every View Transitions navigation.
    // DOMContentLoaded is redundant and would register a second listener on subsequent pages.
    document.addEventListener("astro:page-load", () => {
      enhanceCodeBlocks(document);
      initSideNotes();
    });
  </script>

  <style>
    .post {
      max-width: 720px;
    }
    .post__header {
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-5);
      border-bottom: 1px solid var(--color-border);
    }
    .post__eyebrow {
      display: flex;
      gap: var(--space-2);
      align-items: center;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-muted);
      margin: 0 0 var(--space-3) 0;
    }
    .post__title {
      font-family: var(--font-serif);
      font-size: var(--fs-4xl);
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      font-weight: 500;
      margin: 0 0 var(--space-3) 0;
      color: var(--color-fg);
    }
    .post__lede {
      font-family: var(--font-sans);
      font-size: var(--fs-lg);
      line-height: var(--lh-normal);
      color: var(--color-fg-muted);
      margin: 0 0 var(--space-4) 0;
    }
    .post__tags {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .post__tag-chip {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--color-fg-muted);
      padding: 2px 8px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      display: inline-block;
      text-decoration: none;
      transition:
        border-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }
    .post__tag-chip:hover {
      border-color: var(--color-accent);
      color: var(--color-accent-hover);
    }
    .post__cover {
      margin: 0 0 var(--space-7) 0;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-bg-elevated);
    }
    .post__cover img {
      display: block;
      width: 100%;
      height: auto;
    }
    .post__after {
      max-width: 720px;
      margin: var(--space-6) 0 var(--space-9) 0;
    }
    @media (max-width: 600px) {
      .post__title {
        font-size: var(--fs-3xl); /* down from --fs-4xl */
        line-height: var(--lh-snug);
      }
      .post__lede {
        font-size: var(--fs-base); /* down from --fs-lg */
      }
      .post__header {
        margin-bottom: var(--space-5);
        padding-bottom: var(--space-4);
      }
    }
    @media (max-width: 414px) {
      .post__title {
        font-size: var(--fs-2xl);
      }
    }
  </style>
</BaseLayout>
