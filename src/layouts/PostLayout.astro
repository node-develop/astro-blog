---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="prose prose-slate dark:prose-invert max-w-none">
    <header class="not-prose mb-6">
      <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("ru-RU", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        {updatedDate && <span>· обновлено {updatedDate.toLocaleDateString("ru-RU")}</span>}
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <li class="rounded bg-slate-100 px-2 py-0.5 text-xs dark:bg-slate-800">#{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <slot />
  </article>
</BaseLayout>
