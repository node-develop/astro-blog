---
import "~/styles/content.css";
import BaseLayout from "./BaseLayout.astro";
import CardArt from "~/components/CardArt.astro";
import PostTOC from "~/components/PostTOC.astro";
import MobilePostTOC from "~/components/MobilePostTOC.astro";
import AuthorCard from "~/components/AuthorCard.astro";
import ReadingProgress from "~/components/ReadingProgress.astro";
import PrevNext from "~/components/PrevNext.astro";
import RelatedPosts from "~/components/RelatedPosts.astro";
import Newsletter from "~/components/Newsletter.astro";
import Comments from "~/components/Comments.astro";
import { renderInlineCode } from "~/lib/inline-md";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import { person } from "~/lib/seo/person";
import { resolveTagLabel, getTagDict } from "~/lib/content/tags";
import { bareSlug } from "~/lib/content/slug";
import { postOgPath } from "~/lib/og/post-pages";
import Tldr from "~/components/mdx/Tldr.astro";
import Faq from "~/components/mdx/Faq.astro";
import { getReadingTime, formatReadingTime } from "~/lib/posts/reading-time";
import {
  buildBlogPostingNode,
  buildBreadcrumbsNode,
  buildFaqPageNode,
  buildWebPageNode,
  extractArticleBody,
  type GraphNode,
} from "~/lib/seo/schema";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { canonicalUrl } from "~/lib/seo/url-policy";
// KaTeX CSS is per-page, not global (see src/lib/remark/flag-math.ts) — it
// only ships on posts that actually contain math.
import katexHref from "katex/dist/katex.min.css?url";

interface Props {
  post: CollectionEntry<"posts">;
  headings: readonly MarkdownHeading[];
  hasMath?: boolean;
}

const { post, headings, hasMath = false } = Astro.props;
const { title, description, pubDate, updatedDate, tags, keywords, cover, coverAlt, summary, faq } =
  post.data;
const locale = getLocaleFromPath(Astro.url.pathname);
const canonical = canonicalUrl(Astro.url.pathname);
const slug = bareSlug(post.id);
// Locale-suffixed: the EN page must not inherit the RU card. Shape owned
// by postOgPath() and emitted by src/pages/og/[slug].png.ts.
const ogImagePath = postOgPath(slug, locale);
// Agent-readable twin of this page (see src/pages/blog/[slug].md.ts).
const markdownHref = `${locale === "en" ? "/en" : ""}/blog/${slug}.md`;
// Frontmatter `author` defaults to the canonical person name; an explicit
// frontmatter value is an override for guest posts.
const authorName = post.data.author || person.name;

// Cover is stored as a path relative to /uploads/ (e.g. "2026/04/file.png").
// Accept both bare relatives and pre-prefixed absolutes for forward compatibility.
const coverUrl = cover
  ? cover.startsWith("/") || /^https?:\/\//.test(cover)
    ? cover
    : `/uploads/${cover}`
  : null;

// The site-wide /og-default.* placeholder is not a real cover — those posts,
// and posts with no cover at all, get the slug-seeded editorial artwork
// banner (same visual system as the home-page cards) instead of a generic
// image.
const hasRealCover = coverUrl !== null && !/^\/og-default\.(svg|png)$/.test(coverUrl);
const bodyText = post.body ?? "";
const readingTime = getReadingTime({ text: bodyText, locale });

const siteBase = Astro.site?.toString() ?? "https://artka.dev";
// BlogPosting.image must be a raster (Schema.org / Google Rich Results
// reject SVG). A real uploaded cover wins; otherwise use the per-post
// /og/<slug>.png raster — the same image BaseLayout puts in og:image —
// so JSON-LD and OG agree. The old fallback let the /og-default.svg
// placeholder through, shipping an SVG in every BlogPosting.image.
const absoluteCover =
  coverUrl !== null && hasRealCover
    ? /^https?:\/\//.test(coverUrl)
      ? coverUrl
      : new URL(coverUrl, siteBase).toString()
    : new URL(ogImagePath, siteBase).toString();

const excerpt = extractArticleBody(post.body ?? "", 800);

const blogPostingNode = buildBlogPostingNode({
  locale,
  canonical,
  title,
  description,
  pubDate,
  updatedDate: updatedDate ?? null,
  image: absoluteCover,
  // Authored semantic keywords — tag slugs are archive keys, not keywords.
  keywords,
  articleBody: excerpt.text,
  wordCount: excerpt.fullWordCount,
  ...(tags[0] ? { articleSection: tags[0] } : {}),
  readingMinutes: readingTime,
}) as GraphNode;

const breadcrumbItems = [
  {
    name: locale === "ru" ? "Главная" : "Home",
    href: canonicalUrl(locale === "ru" ? "/" : "/en/"),
  },
  { name: t(locale, "blog.title"), href: canonicalUrl(locale === "ru" ? "/blog" : "/en/blog") },
  { name: title },
] as const;

const breadcrumbNode = buildBreadcrumbsNode({ canonical, items: breadcrumbItems }) as GraphNode;

const webPageNode = buildWebPageNode({
  locale,
  canonical,
  name: title,
  description,
  type: "ItemPage",
  primaryImageOfPage: absoluteCover,
  dateModified: updatedDate ?? pubDate,
  breadcrumbId: `${canonical}#breadcrumbs`,
  mainEntityId: `${canonical}#blogposting`,
}) as GraphNode;

const faqItems = faq ?? [];
const faqNode = buildFaqPageNode({
  canonical,
  items: faqItems,
  aboutId: `${canonical}#blogposting`,
});

const tagDict = getTagDict(locale);
const tagsHrefBase = locale === "en" ? "/en/tags/" : "/tags/";

const primaryTag = tags?.[0] ?? "—";
const pubYear = pubDate.getFullYear();
const pagefindFilter = `tag:${primaryTag}, date:${pubYear}`;

const aboutHref = locale === "en" ? "/en/about/" : "/about/";
const formattedPubDate = pubDate.toLocaleDateString(locale === "ru" ? "ru-RU" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedUpdatedDate = updatedDate
  ? updatedDate.toLocaleDateString(locale === "ru" ? "ru-RU" : "en-US")
  : null;
---

<BaseLayout
  title={post.data.seoTitle ?? title}
  description={post.data.seoDescription ?? description}
  ogImage={post.data.socialImage ?? ogImagePath}
  ogImageAlt={post.data.socialImageAlt ?? title}
  ogImageWidth={post.data.socialImageWidth}
  ogImageHeight={post.data.socialImageHeight}
  ogType="article"
  noSidebar={true}
  extraSchemaNodes={[webPageNode, blogPostingNode, breadcrumbNode, faqNode]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={authorName} />
    {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="text/markdown" href={markdownHref} title={title} />
    {hasMath && <link rel="stylesheet" href={katexHref} />}
  </Fragment>

  <PostTOC slot="toc" headings={headings} />

  <ReadingProgress targetSelector=".post" />

  <MobilePostTOC headings={headings} />

  <article
    class="post"
    data-content-revision={post.data.apiRevision}
    data-pagefind-body
    data-pagefind-filter={pagefindFilter}
    data-pagefind-meta={`title:${title}`}
  >
    <header class="post__header">
      <h1 class="post__title" transition:name={`post-title-${slug}`}>{title}</h1>
      {description && <p class="post__lede" set:html={renderInlineCode(description)} />}
      <div class="post__byline" itemscope itemtype="https://schema.org/Person">
        <a href={aboutHref} class="post__byline-avatar" aria-hidden="true" tabindex="-1">
          <picture>
            <source
              type="image/avif"
              srcset="/avatar-64.avif 64w, /avatar-128.avif 128w, /avatar-288.avif 288w"
              sizes="32px"
            />
            <source
              type="image/webp"
              srcset="/avatar-64.webp 64w, /avatar-128.webp 128w, /avatar-288.webp 288w"
              sizes="32px"
            />
            <img
              src="/avatar-64.webp"
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>
        <a href={aboutHref} class="post__byline-name" itemprop="name">{person.name}</a>
        <span class="post__byline-sep" aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()} class="post__byline-date">{formattedPubDate}</time>
        <span class="post__byline-sep" aria-hidden="true">·</span>
        <span class="post__byline-reading">{formatReadingTime(readingTime, locale)}</span>
        {
          formattedUpdatedDate && (
            <>
              <span class="post__byline-sep" aria-hidden="true">
                ·
              </span>
              <span class="post__byline-updated">
                {t(locale, "post.updated").toLowerCase()} {formattedUpdatedDate}
              </span>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <ul class="post__tags" aria-label={t(locale, "post.tags")}>
            {tags.map((tag: string) => (
              <li>
                <a class="post__tag-chip" href={`${tagsHrefBase}${tag}/`}>
                  #{resolveTagLabel(tag, locale, tagDict)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      hasRealCover ? (
        <figure class="post__cover">
          <img
            src={coverUrl}
            alt={coverAlt ?? ""}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          {post.data.coverCaption && <figcaption>{post.data.coverCaption}</figcaption>}
        </figure>
      ) : (
        <div class="post__art">
          <CardArt seed={slug} />
        </div>
      )
    }
    {summary && <Tldr text={summary} />}
    <div class="post__body prose">
      <slot />
    </div>
    {faqItems.length > 0 && <Faq items={faqItems} />}
    <PrevNext currentSlug={slug} locale={locale} />
    <AuthorCard />
  </article>

  <aside class="post__after">
    <RelatedPosts currentSlug={slug} locale={locale} />
    <Newsletter />
    <Comments />
  </aside>

  <script>
    import { enhanceCodeBlocks } from "~/lib/enhance-code-blocks";
    import { initSideNotes } from "~/lib/posts/side-notes";

    // astro:page-load fires on initial mount and after every View Transitions navigation.
    // DOMContentLoaded is redundant and would register a second listener on subsequent pages.
    document.addEventListener("astro:page-load", () => {
      enhanceCodeBlocks(document);
      initSideNotes();
    });
  </script>

  <style>
    .post {
      max-width: 720px;
      margin-inline: auto;
    }
    .post__header {
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-5);
      border-bottom: 1px solid var(--color-border);
    }
    .post__byline {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      align-items: center;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-muted);
      margin: var(--space-4) 0 0 0;
    }
    .post__byline-avatar {
      line-height: 0;
      display: inline-block;
    }
    .post__byline-avatar img {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
      object-fit: cover;
      display: block;
    }
    .post__byline-name {
      color: var(--color-fg);
      text-decoration: none;
      font-weight: 500;
    }
    .post__byline-name:hover {
      color: var(--color-accent);
    }
    .post__byline-sep {
      color: var(--color-fg-subtle);
    }
    .post__byline-date,
    .post__byline-reading,
    .post__byline-updated {
      color: var(--color-fg-muted);
      text-transform: uppercase;
    }
    .post__title {
      font-family: var(--font-serif);
      font-size: var(--fs-4xl);
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      font-weight: 500;
      margin: 0 0 var(--space-3) 0;
      color: var(--color-fg);
    }
    .post__lede {
      font-family: var(--font-sans);
      font-size: var(--fs-lg);
      line-height: var(--lh-normal);
      color: var(--color-fg-muted);
      margin: 0 0 var(--space-4) 0;
    }
    .post__tags {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .post__tag-chip {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--color-fg-muted);
      padding: 2px 8px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      display: inline-block;
      text-decoration: none;
      transition:
        border-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }
    .post__tag-chip:hover {
      border-color: var(--color-accent);
      color: var(--color-accent-hover);
    }
    .post__cover {
      margin: 0 0 var(--space-7) 0;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-bg-elevated);
    }
    .post__cover img {
      display: block;
      width: 100%;
      height: auto;
    }
    .post__art {
      height: 220px;
      margin: 0 0 var(--space-7) 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .post__after {
      max-width: 720px;
      margin: var(--space-6) auto var(--space-9);
    }
    @media (max-width: 600px) {
      .post__title {
        font-size: var(--fs-3xl); /* down from --fs-4xl */
        line-height: var(--lh-snug);
      }
      .post__lede {
        font-size: var(--fs-base); /* down from --fs-lg */
      }
      .post__header {
        margin-bottom: var(--space-5);
        padding-bottom: var(--space-4);
      }
    }
    @media (max-width: 414px) {
      .post__title {
        font-size: var(--fs-2xl);
      }
    }
  </style>
</BaseLayout>
