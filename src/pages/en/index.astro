---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";
import HomeMasthead from "~/components/HomeMasthead.astro";
import Ticker from "~/components/Ticker.astro";
import HomeFeaturedCard from "~/components/HomeFeaturedCard.astro";
import PostCard from "~/components/PostCard.astro";
import HomeCourseBand from "~/components/HomeCourseBand.astro";
import HomeTopics from "~/components/HomeTopics.astro";
import HomeAuthorCard from "~/components/HomeAuthorCard.astro";
import { getOrderedPosts } from "~/lib/content/loader";
import { assignArtVariants } from "~/lib/content/card-art";
import { bareSlug } from "~/lib/content/slug";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import { getEntry } from "astro:content";
import { homeFrontmatterSchema } from "~/lib/content/home-schema";
import {
  buildPostItemListNode,
  buildWebPageNode,
  itemListId,
  type GraphNode,
} from "~/lib/seo/schema";
import { landingOgPath } from "~/lib/og/landing-pages";
import { renderHomeMarkdown } from "~/lib/agents/markdown";
import {
  appendVary,
  markdownResponse,
  negotiateRepresentation,
  notAcceptableResponse,
} from "~/lib/http/content-negotiation";
import { canonicalPath, canonicalUrl } from "~/lib/seo/url-policy";
import { applyPublicHtmlCache } from "~/lib/http/public-cache";

const locale = getLocaleFromPath(Astro.url.pathname);
const representation = negotiateRepresentation(Astro.request.headers.get("Accept"));
if (!representation) return notAcceptableResponse(Astro.request);
const posts = await getOrderedPosts({ locale });
const featured = posts[0];
// Featured post + up to 6 cards = the whole current archive linked from
// the homepage. The grid auto-flows extra rows, so raising this bound is
// a layout no-op; keep it >= the archive size so no post is orphaned.
const grid = posts.slice(1, 7);
const blogHref = canonicalPath("/en/blog");
const courseHref = canonicalPath("/en/courses/claude-code-guide");
const postHref = (id: string): string => canonicalPath(`${blogHref}${bareSlug(id)}`);
const gridVariants = assignArtVariants(grid.map((p) => bareSlug(p.entry.id)));
// See the RU twin: exactly the posts this page links, in the order shown.
const listedPosts = [featured, ...grid].filter((p) => p !== undefined);

const homeEntry = await getEntry("site", "en/home");
const data = homeFrontmatterSchema.parse(homeEntry?.data ?? {});

// See the RU twin: ticker copy is one item per line in en/home.md.
const tickerItems = (data.tickerItems ?? "")
  .split("\n")
  .map((line) => line.trim())
  .filter((line) => line.length > 0);

if (representation === "text/markdown") {
  return markdownResponse(
    Astro.request,
    renderHomeMarkdown({
      locale,
      title: data.heroTitle ?? data.metaTitle ?? "AI agents and production backend",
      introduction: data.heroLede ?? data.metaDescription ?? "",
      posts: listedPosts.map((post) => ({
        title: post.entry.data.title,
        description: post.entry.data.description,
        url: canonicalUrl(postHref(post.entry.id)),
      })),
    }),
  );
}
appendVary(Astro.response.headers, "Accept", "Accept-Encoding");
applyPublicHtmlCache(Astro.request, Astro.response.headers);

const canonical = canonicalUrl(Astro.url.pathname);
// Newest of pubDate/updatedDate across the listed posts — an edited post
// must bump the index's dateModified, not only a newly published one.
const latestModified = posts.reduce<Date | null>((acc, p) => {
  const d = p.entry.data.updatedDate ?? p.entry.data.pubDate;
  return acc && acc.getTime() > d.getTime() ? acc : d;
}, null);

const ogImagePath = landingOgPath("home", locale);
const primaryImageOfPage = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

// See the RU twin: the articles the home page links, in the markup.
const itemListNode = buildPostItemListNode({
  locale,
  canonical,
  name: data.latestLabel ?? data.metaTitle ?? "",
  items: listedPosts.map((p) => ({
    url: canonicalUrl(postHref(p.entry.id)),
    headline: p.entry.data.title,
  })),
}) as GraphNode;

const webPageNode = buildWebPageNode({
  locale,
  canonical,
  name: data.metaTitle ?? "",
  description: data.metaDescription ?? "",
  type: "WebPage",
  primaryImageOfPage,
  dateModified: latestModified,
  mainEntityId: itemListId(canonical),
}) as GraphNode;
---

<BaseLayout
  title={data.metaTitle ?? ""}
  description={data.metaDescription ?? ""}
  ogImage={ogImagePath}
  fullWidth={true}
  noSidebar={true}
  extraSchemaNodes={[webPageNode, itemListNode]}
>
  <div class="home">
    <HomeMasthead
      eyebrow={data.heroEyebrow}
      title={data.heroTitle}
      highlight={data.heroHighlight}
      lede={data.heroLede}
      cta={data.heroCta}
      ctaHref={blogHref}
      sealPhrase={data.sealPhrase}
    />

    <Ticker items={tickerItems} label={t(locale, "ticker.aria")} />

    <HomeTopics />

    {
      featured && (
        <HomeFeaturedCard
          entry={featured.entry}
          href={postHref(featured.entry.id)}
          locale={locale}
        />
      )
    }

    {
      grid.length > 0 && (
        <section class="home__grid-section" aria-labelledby="latest-label">
          <h2 class="home__grid-label" id="latest-label">
            {data.latestLabel}
          </h2>
          <div class="home__grid">
            {grid.map((p, i) => (
              <PostCard
                entry={p.entry}
                href={postHref(p.entry.id)}
                locale={locale}
                artVariant={gridVariants[i]}
                index={i + 2}
              />
            ))}
          </div>
        </section>
      )
    }

    <HomeCourseBand
      eyebrow={data.courseEyebrow}
      title={data.courseTitle}
      lede={data.courseLede}
      cta={data.courseCta}
      href={courseHref}
    />

    <HomeAuthorCard
      label={data.authorLabel ?? ""}
      bio={data.authorBio ?? ""}
      linksAria={data.authorLinksAria ?? ""}
    />
  </div>

  <style>
    .home {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
      max-width: 1080px;
      margin: 0 auto;
    }
    /* See the RU twin: the band sits flush under the statement. */
    .home > :global(.ticker) {
      margin-top: calc(-1 * var(--space-7));
    }
    .home__grid-section {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .home__grid-label {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-subtle);
      font-weight: 500;
      margin: 0;
    }
    .home__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
    @media (max-width: 900px) {
      .home__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 640px) {
      .home__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</BaseLayout>
