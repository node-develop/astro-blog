---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SiteSidebar from "~/components/SiteSidebar.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import { getEntry, render } from "astro:content";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { buildLandingNodes } from "~/lib/seo/schema";

const locale = getLocaleFromPath(Astro.url.pathname);
const slug = locale === "en" ? "en/about" : "about";
const entry = await getEntry("site", slug);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const homeAbs = new URL(locale === "en" ? "/en/" : "/", Astro.site ?? Astro.url).toString();
const description = entry.data.description ?? t(locale, "meta.about.description");

const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "nav.about") },
] as const;

const nodes = buildLandingNodes({
  locale,
  canonical,
  name: entry.data.title,
  description,
  type: "AboutPage",
  breadcrumb: breadcrumbItems,
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  fullWidth={true}
  extraSchemaNodes={nodes}
>
  <SiteSidebar slot="sidebar" />
  <article class="prose">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <Content />
  </article>
</BaseLayout>
