---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";
import SiteSidebar from "~/components/SiteSidebar.astro";
import HomeAuthorCard from "~/components/HomeAuthorCard.astro";
import HomeTopics from "~/components/HomeTopics.astro";
import { getOrderedPosts } from "~/lib/content/loader";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import { buildWebPageNode, type GraphNode } from "~/lib/seo/schema";

const locale = getLocaleFromPath(Astro.url.pathname);
const posts = await getOrderedPosts({ locale });
const latest = posts.slice(0, 3);
const blogHref = locale === "en" ? "/en/blog" : "/blog";
const courseHref = locale === "en" ? "/en/courses/claude-code-guide" : "/courses/claude-code-guide";
const bareSlug = (id: string): string => id.replace(/^en\//, "");

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const latestModified = posts.reduce<Date | null>((acc, p) => {
  const d = p.entry.data.pubDate;
  return acc && acc.getTime() > d.getTime() ? acc : d;
}, null);

// Home is a WebPage, not a CollectionPage — it's a landing with hero +
// author card + flagship course + 3 most-recent posts, not a paginated
// archive. dateModified tracks freshness off the latest post.
const webPageNode = buildWebPageNode({
  locale,
  canonical,
  name: t(locale, "meta.home.title"),
  description: t(locale, "meta.home.description"),
  type: "WebPage",
  primaryImageOfPage: new URL("/og-default.png", Astro.site ?? Astro.url).toString(),
  dateModified: latestModified,
}) as GraphNode;
---

<BaseLayout
  title={t(locale, "meta.home.title")}
  description={t(locale, "meta.home.description")}
  fullWidth={true}
  extraSchemaNodes={[webPageNode]}
>
  <SiteSidebar slot="sidebar" />

  <section class="hero">
    <p class="hero__eyebrow">{t(locale, "home.eyebrow")}</p>
    <h1 class="hero__title">
      {t(locale, "home.heroTitle")}
    </h1>
    <p class="hero__lede">
      {t(locale, "home.heroLede")}
    </p>
    <a href={blogHref} class="hero__cta">{t(locale, "home.cta")}</a>
  </section>

  <HomeAuthorCard />

  <HomeTopics />

  <aside class="course-card">
    <p class="course-card__eyebrow">{t(locale, "home.courseEyebrow")}</p>
    <h2 class="course-card__title">
      <a href={courseHref}>{t(locale, "home.courseTitle")}</a>
    </h2>
    <p class="course-card__lede">{t(locale, "home.courseLede")}</p>
    <a href={courseHref} class="course-card__cta">{t(locale, "home.courseCta")}</a>
  </aside>

  <section class="latest" aria-labelledby="latest-label">
    <h3 class="latest__label" id="latest-label">{t(locale, "home.latestLabel")}</h3>
    <ul class="latest__list">
      {
        latest.map((p) => (
          <li>
            <a href={`${blogHref}/${bareSlug(p.entry.id)}`} class="latest__link">
              <span class="latest__title">{p.entry.data.title}</span>
              <time datetime={p.entry.data.pubDate.toISOString()} class="latest__date">
                {p.entry.data.pubDate.toLocaleDateString(locale === "ru" ? "ru-RU" : "en-US", {
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .hero {
      max-width: 720px;
      padding: var(--space-6) 0;
    }
    .hero__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-subtle);
      margin: 0 0 var(--space-4) 0;
    }
    .hero__title {
      font-family: var(--font-serif);
      font-size: var(--fs-3xl);
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      font-weight: 500;
      margin: 0 0 var(--space-4) 0;
      color: var(--color-fg);
    }
    .hero__lede {
      font-size: var(--fs-lg);
      line-height: var(--lh-normal);
      color: var(--color-fg-muted);
      margin: 0 0 var(--space-5) 0;
    }
    .hero__cta {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--color-accent);
      text-decoration: none;
      border-bottom: 1px dashed var(--color-accent);
      padding-bottom: 1px;
    }
    .hero__cta:hover {
      color: var(--color-accent-hover);
    }

    .course-card {
      max-width: 720px;
      margin-top: var(--space-7);
      padding: var(--space-5) var(--space-6);
      border: 1px solid var(--color-accent);
      border-radius: var(--radius-md);
      background: var(--color-accent-subtle);
    }
    .course-card__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-accent);
      margin: 0 0 var(--space-2) 0;
    }
    .course-card__title {
      font-family: var(--font-serif);
      font-size: var(--fs-xl);
      font-weight: 500;
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      margin: 0 0 var(--space-2) 0;
      color: var(--color-fg);
    }
    .course-card__title a {
      color: inherit;
      text-decoration: none;
    }
    .course-card__title a:hover {
      color: var(--color-accent);
    }
    .course-card__lede {
      margin: 0 0 var(--space-3) 0;
      color: var(--color-fg-muted);
      line-height: var(--lh-normal);
      text-wrap: pretty;
    }
    .course-card__cta {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--color-accent);
      text-decoration: none;
      border-bottom: 1px dashed var(--color-accent);
      padding-bottom: 1px;
    }
    .course-card__cta:hover {
      color: var(--color-accent-hover);
    }

    .latest {
      margin-top: var(--space-8);
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
      max-width: 720px;
    }
    .latest__label {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-subtle);
      font-weight: 500;
      margin: 0 0 var(--space-4) 0;
    }
    .latest__list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .latest__link {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-3) 0;
      border-bottom: 1px dotted var(--color-border);
      color: var(--color-fg);
      text-decoration: none;
    }
    .latest__title {
      font-family: var(--font-serif);
      font-size: var(--fs-lg);
      line-height: var(--lh-snug);
    }
    .latest__date {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--color-fg-subtle);
    }
    .latest__link:hover .latest__title {
      color: var(--color-accent-hover);
    }
  </style>
</BaseLayout>
