---
export const prerender = false;
import BaseLayout from "~/layouts/BaseLayout.astro";
import { safeNext } from "~/lib/auth/safe-next";

if (Astro.locals.user) return Astro.redirect("/admin/");
// Validate ?next=... server-side: reject anything that would bounce the user
// to a third-party origin (CWE-601 open redirect). The same `next` is rendered
// into both the form and the GitHub OAuth callback button below, so a single
// sanitisation here covers both flows.
const next = safeNext(Astro.url.searchParams.get("next"));
const githubEnabled = Boolean(process.env.GITHUB_CLIENT_ID && process.env.GITHUB_CLIENT_SECRET);
---

<BaseLayout title="Вход" description="Страница входа в админку" noindex={true}>
  <div class="login">
    <h1 class="login__title">Вход</h1>
    <form id="login-form" data-callback={next} class="login__form">
      <p id="login-error" hidden class="login__error">Неверный email или пароль</p>
      <label class="login__field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="login__field">
        <span>Пароль</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit" class="login__submit">Войти</button>
    </form>
    {
      githubEnabled && (
        <>
          <div class="login__or">
            <span class="login__rule" />
            <span>или</span>
            <span class="login__rule" />
          </div>
          <button id="github-login" type="button" data-callback={next} class="login__github">
            <svg viewBox="0 0 24 24" class="login__gh-icon" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.94c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.66.79.55 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.65 18.35.5 12 .5z" />
            </svg>
            Войти через GitHub
          </button>
        </>
      )
    }
  </div>

  <style>
    /* Poster login slab. This page used to be raw Tailwind utilities with
       `dark:` variants; those follow prefers-color-scheme, which disagrees
       with the site's explicit [data-theme] toggle, and `bg-brand-500` was
       left over from the old palette and resolved to nothing — the submit
       button had white text on paper. Tokens instead, on both counts. */
    .login {
      max-width: 26rem;
      margin: var(--space-7) auto var(--space-8);
      padding: var(--space-6);
      background: var(--color-bg-elevated);
      border: var(--stroke-slab) solid var(--color-fg);
      box-shadow: var(--shadow-soft);
    }
    .login__title {
      font-family: var(--font-serif);
      font-weight: 800;
      font-size: var(--fs-3xl);
      line-height: var(--lh-display);
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      margin: 0 0 var(--space-5);
    }
    .login__form {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .login__error {
      margin: 0;
      padding: var(--space-2) var(--space-3);
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--color-danger);
      background: color-mix(in srgb, var(--color-danger) 14%, var(--color-bg-elevated));
      border: var(--stroke-bold) solid var(--color-danger);
    }
    .login__field {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .login__field > span {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-muted);
    }
    .login__field input {
      width: 100%;
      font-family: var(--font-sans);
      font-size: var(--fs-base);
      padding: var(--space-2) var(--space-3);
      color: var(--color-fg);
      background: var(--color-bg);
      border: var(--stroke-bold) solid var(--color-fg);
      border-radius: var(--radius-md);
    }
    .login__submit,
    .login__github {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      padding: var(--space-3) var(--space-4);
      border: var(--stroke-bold) solid var(--color-fg);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition:
        background var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out),
        box-shadow var(--dur-fast) var(--ease-out);
    }
    .login__submit {
      align-self: flex-start;
      background: var(--color-fill);
      color: var(--color-on-fill);
      box-shadow: var(--shadow-press);
    }
    .login__submit:not(:disabled):hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--color-shadow);
    }
    .login__submit:not(:disabled):active {
      transform: none;
      box-shadow: none;
    }
    .login__submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      box-shadow: none;
    }
    .login__or {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin: var(--space-5) 0;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-muted);
    }
    .login__rule {
      flex: 1;
      height: var(--stroke-hair);
      background: var(--color-border);
    }
    .login__github {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      background: transparent;
      color: var(--color-fg);
    }
    .login__github:not(:disabled):hover {
      background: var(--color-fill);
      color: var(--color-on-fill);
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-press);
    }
    .login__github:not(:disabled):active {
      transform: none;
      box-shadow: none;
    }
    .login__github:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .login__gh-icon {
      width: 20px;
      height: 20px;
    }
  </style>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const errorEl = document.getElementById("login-error");
    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (errorEl) errorEl.hidden = true;
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        const data = new FormData(form);
        const callback = form.dataset.callback || "/admin/";
        try {
          const res = await fetch("/api/auth/sign-in/email/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({
              email: String(data.get("email") ?? ""),
              password: String(data.get("password") ?? ""),
            }),
          });
          if (res.ok) {
            window.location.href = callback;
            return;
          }
        } catch (err) {
          console.error(err);
        }
        if (submitBtn) submitBtn.disabled = false;
        if (errorEl) errorEl.hidden = false;
      });
    }

    const githubBtn = document.getElementById("github-login") as HTMLButtonElement | null;
    if (githubBtn) {
      githubBtn.addEventListener("click", async () => {
        githubBtn.disabled = true;
        try {
          const res = await fetch("/api/auth/sign-in/social/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({
              provider: "github",
              callbackURL: githubBtn.dataset.callback || "/admin/",
            }),
          });
          const data = (await res.json()) as { url?: string };
          if (data.url) {
            window.location.href = data.url;
            return;
          }
        } catch (err) {
          console.error(err);
        }
        githubBtn.disabled = false;
        alert("Не удалось начать GitHub-вход");
      });
    }
  </script>
</BaseLayout>
