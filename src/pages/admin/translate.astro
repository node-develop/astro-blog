---
export const prerender = false;

import AdminLayout from "~/layouts/AdminLayout.astro";
import GenericTranslatePanel from "~/components/admin/GenericTranslatePanel";
import { readdir, stat } from "node:fs/promises";
import { join } from "node:path";
import { existsSync } from "node:fs";
import { PATHS } from "~/lib/translate/site-config";

/**
 * Generic translate page for collections without a full admin CRUD editor:
 * projects, courses (landings), lessons. The two top-of-funnel cases —
 * posts and site pages — get the Translate/Publish controls inside their
 * existing per-slug editors (EditorShell, SiteEditor).
 *
 * We enumerate slugs at request time (not build-time) so the dropdown
 * always reflects the current filesystem.
 */
const listMd = async (dir: string): Promise<ReadonlyArray<string>> => {
  if (!existsSync(dir)) return [];
  const files = await readdir(dir);
  return files
    .filter((f) => /\.md$/.test(f) && !f.startsWith(".") && !f.startsWith("_"))
    .map((f) => f.replace(/\.md$/, ""));
};

const projectsSlugs = await listMd(PATHS.projectsDir);

// courses: each direct subdirectory of `coursesDir` that contains _index.md.
const coursesSlugs: string[] = [];
const lessonsSlugs: string[] = [];
if (existsSync(PATHS.coursesDir)) {
  for (const entry of await readdir(PATHS.coursesDir)) {
    const courseDir = join(PATHS.coursesDir, entry);
    const courseStat = await stat(courseDir);
    if (!courseStat.isDirectory()) continue;
    if (existsSync(join(courseDir, "_index.md"))) coursesSlugs.push(entry);
    // Lessons are direct .md files inside the course dir (excluding _index
    // and the en/ subdir).
    for (const file of await readdir(courseDir)) {
      if (!/\.md$/.test(file)) continue;
      if (file === "_index.md") continue;
      lessonsSlugs.push(`${entry}/${file.replace(/\.md$/, "")}`);
    }
  }
}

const slugsByCollection = {
  projects: projectsSlugs,
  courses: coursesSlugs,
  lessons: lessonsSlugs,
} as const;
---

<AdminLayout title="Переводы и публикация">
  <header class="admin-page-header">
    <h1>Переводы и публикация</h1>
    <p class="admin-page-header__lead">
      Запуск перевода RU→EN и публикации (через GitHub API) для коллекций без полного админ-CRUD —
      <code>projects</code>, <code>courses</code> (лендинги), <code>lessons</code>. Для <code
        >posts</code
      > и <code>site</code> кнопки встроены в редакторы.
    </p>
  </header>

  <GenericTranslatePanel client:load slugsByCollection={slugsByCollection} />
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-5);
  }
  .admin-page-header h1 {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    margin: 0 0 var(--space-2) 0;
  }
  .admin-page-header__lead {
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    margin: 0;
    line-height: var(--lh-normal);
    max-width: 64ch;
  }
  .admin-page-header__lead code {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    color: var(--color-accent);
  }
</style>
