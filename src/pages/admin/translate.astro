---
export const prerender = false;

import AdminLayout from "~/layouts/AdminLayout.astro";
import GenericTranslatePanel from "~/components/admin/GenericTranslatePanel";
import { readdir } from "node:fs/promises";
import { existsSync } from "node:fs";
import { PATHS } from "~/lib/translate/site-config";

/**
 * Generic translate page for the collection without a full admin CRUD editor:
 * projects. The two top-of-funnel cases —
 * posts and site pages — get the Translate/Publish controls inside their
 * existing per-slug editors (EditorShell, SiteEditor).
 *
 * We enumerate slugs at request time (not build-time) so the dropdown
 * always reflects the current filesystem.
 */
const listMd = async (dir: string): Promise<ReadonlyArray<string>> => {
  if (!existsSync(dir)) return [];
  const files = await readdir(dir);
  return files
    .filter((f) => /\.md$/.test(f) && !f.startsWith(".") && !f.startsWith("_"))
    .map((f) => f.replace(/\.md$/, ""));
};

const projectSlugs = await listMd(PATHS.projectsDir);
---

<AdminLayout title="Переводы и публикация">
  <header class="admin-page-header">
    <h1>Переводы и публикация</h1>
    <p class="admin-page-header__lead">
      Запуск перевода RU→EN и публикации (через GitHub API) для коллекции без полного админ-CRUD —
      <code>projects</code>. Для <code>posts</code> и <code>site</code> кнопки встроены в редакторы.
    </p>
  </header>

  <GenericTranslatePanel client:load projectSlugs={projectSlugs} />
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-5);
  }
  .admin-page-header h1 {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    margin: 0 0 var(--space-2) 0;
  }
  .admin-page-header__lead {
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
    margin: 0;
    line-height: var(--lh-normal);
    max-width: 64ch;
  }
  .admin-page-header__lead code {
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    color: var(--color-accent);
  }
</style>
