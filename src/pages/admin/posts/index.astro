---
export const prerender = false;

import AdminLayout from "~/layouts/AdminLayout.astro";
import PostList, { type PostListItem } from "~/components/admin/PostList";
import { listAllMeta } from "~/lib/db/repo/posts-meta";
import { defaultMetaFor } from "~/lib/content/loader";
import { listPostsFromDisk } from "~/lib/content/post-io";
import { POSTS_DIR } from "~/lib/fs/paths";

// Read from disk, NOT `getCollection("posts")`: the content layer is a
// build-time snapshot and does not see posts created/edited/deleted by the
// admin in the SSR runtime.
// Admin sees ALL entries including drafts/hidden — don't filter by draft here.
const files = await listPostsFromDisk(POSTS_DIR);
const metaRows = await listAllMeta();
const metaBySlug = new Map(metaRows.map((m) => [m.slug, m]));
const merged = files.map((file) => ({
  file,
  meta: metaBySlug.get(file.slug) ?? defaultMetaFor(file.slug),
}));
// Same ordering as `sortWithMeta` in ~/lib/content/loader (pinned first, then `order`).
const sorted = [...merged].sort((a, b) => {
  if (a.meta.pinned !== b.meta.pinned) return a.meta.pinned ? -1 : 1;
  return a.meta.order - b.meta.order;
});
const initial: PostListItem[] = sorted.map((p) => ({
  slug: p.file.slug,
  title: p.file.frontmatter.title,
  description: p.file.frontmatter.description,
  pubDate: p.file.frontmatter.pubDate.toISOString(),
  draft: p.file.frontmatter.draft,
  tags: [...p.file.frontmatter.tags],
  order: p.meta.order,
  pinned: p.meta.pinned,
  hidden: p.meta.hiddenFromList,
}));
---

<AdminLayout title="Статьи">
  <header class="admin-page-header">
    <h1>Статьи</h1>
    <a href="/admin/posts/new/" class="admin-button">Новая статья</a>
  </header>

  <PostList client:load initial={initial} />
</AdminLayout>

<style>
  .admin-page-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
  }
  .admin-page-header h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    margin: 0;
  }
  .admin-button {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-bg);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .admin-button:hover {
    background: var(--color-accent-hover);
  }
</style>
