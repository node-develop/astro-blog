---
export const prerender = false;

import AdminLayout from "~/layouts/AdminLayout.astro";
import HomeEditor from "~/components/admin/HomeEditor";
import { join } from "node:path";
import { readHomeFromDisk } from "~/lib/content/write-home";
import type { HomeFrontmatter } from "~/lib/content/home-schema";
import { SITE_DIR } from "~/lib/fs/paths";
import type { HomeData } from "~/components/admin/HomeEditor";

// Auth is handled by middleware for all /admin/* routes.

// Read from disk, NOT from `getEntry("site", …)`: the content layer is a
// build-time snapshot and is stale in the SSR runtime after the editor
// (or `pnpm translate`) writes home.md.
const ruFm = await readHomeFromDisk(join(SITE_DIR, "home.md"));
const enFm = await readHomeFromDisk(join(SITE_DIR, "en", "home.md"));

// Project the 14 editable fields (drops title/sourceHash/manuallyEdited and
// omits undefined keys — exactOptionalPropertyTypes).
const toHomeData = (fm: HomeFrontmatter): HomeData => {
  const { title: _t, sourceHash: _s, manuallyEdited: _m, ...fields } = fm;
  return Object.fromEntries(Object.entries(fields).filter(([, v]) => v !== undefined)) as HomeData;
};

// home.md may not exist yet. Degrade gracefully with empty objects so the
// editor still renders.
const ruData: HomeData = ruFm ? toHomeData(ruFm) : {};
const enData: HomeData | null = enFm ? toHomeData(enFm) : null;
const enManuallyEdited = enFm?.manuallyEdited === true;
---

<AdminLayout title="Главная страница">
  <header class="admin-page-header">
    <h1>Главная страница</h1>
    <div class="admin-page-header__meta">
      <code>site/home</code>
      <a href="/admin/site/">← Все страницы</a>
    </div>
  </header>

  <HomeEditor client:load ru={ruData} en={enData} enManuallyEdited={enManuallyEdited} />
</AdminLayout>

<style>
  .admin-page-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-5);
  }
  .admin-page-header h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    margin: 0;
  }
  .admin-page-header__meta {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .admin-page-header__meta a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .admin-page-header__meta a:hover {
    text-decoration: underline;
  }
</style>
