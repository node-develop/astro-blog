---
export const prerender = false;
import BaseLayout from "~/layouts/BaseLayout.astro";
import { db } from "~/lib/db";
import { asc } from "drizzle-orm";
import { postsMeta } from "~/lib/db/schema";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");

const recentMeta = await db.select().from(postsMeta).orderBy(asc(postsMeta.order)).limit(20);
---

<BaseLayout title="Админка" description="Управление блогом">
  <h1 class="mb-6 text-3xl font-bold">Админка</h1>
  <p class="mb-6 text-slate-600 dark:text-slate-400">
    Привет, <strong>{user.name ?? user.email}</strong> ({user.role})
  </p>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-semibold">Посты</h2>
    {
      recentMeta.length === 0 ? (
        <p class="text-slate-500">Нет записей с метаданными.</p>
      ) : (
        <ul class="divide-y divide-slate-200 dark:divide-slate-800">
          {recentMeta.map((meta) => (
            <li class="py-3">
              <a
                href={`/blog/${meta.slug}`}
                class="hover:text-brand-500 flex items-center justify-between"
              >
                <span>{meta.slug}</span>
                <span class="text-xs text-slate-500">
                  {meta.pinned ? "📌 " : ""}
                  {meta.hiddenFromList ? "hidden" : "visible"} · #{meta.order}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <a
    href="/admin/posts/new"
    class="bg-brand-500 hover:bg-brand-700 inline-block rounded px-4 py-2 text-white"
  >
    + Новый пост
  </a>
</BaseLayout>
