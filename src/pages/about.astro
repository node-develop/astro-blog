---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Avatar from "~/components/Avatar.astro";
import { getEntry, render } from "astro:content";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { buildLandingNodes } from "~/lib/seo/landing";
import { landingOgPath } from "~/lib/og/landing-pages";

const locale = getLocaleFromPath(Astro.url.pathname);
const slug = locale === "en" ? "en/about" : "about";
const entry = await getEntry("site", slug);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const homeAbs = new URL(locale === "en" ? "/en/" : "/", Astro.site ?? Astro.url).toString();
const description = entry.data.description ?? t(locale, "meta.about.description");

const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "nav.about") },
] as const;

const ogImagePath = landingOgPath("about", locale);
const primaryImageOfPage = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

const nodes = buildLandingNodes({
  locale,
  canonical,
  name: entry.data.title,
  description,
  type: "AboutPage",
  breadcrumb: breadcrumbItems,
  primaryImageOfPage,
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  ogImage={ogImagePath}
  fullWidth={true}
  noSidebar={true}
  extraSchemaNodes={nodes}
>
  <article class="prose">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <h1>{entry.data.title}</h1>
    <Avatar size="lg" />
    <Content />
  </article>
  <style>
    /* The sidebar column is gone (noSidebar) - keep prose at a readable
       measure, centered in the full-width main column. */
    .prose {
      max-width: 720px;
      margin-inline: auto;
    }
  </style>
</BaseLayout>
