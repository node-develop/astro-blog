---
import { getEntry, render } from "astro:content";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { buildLandingNodes } from "~/lib/seo/landing";
import { canonicalUrl } from "~/lib/seo/url-policy";

const locale = getLocaleFromPath(Astro.url.pathname);
const entry = await getEntry("site", "privacy");
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);

const canonical = canonicalUrl(Astro.url.pathname);
const homeAbs = new URL("/", Astro.site ?? Astro.url).toString();
const description =
  entry.data.description ?? "Как artka.dev обрабатывает аналитику, настройки и обращения.";
const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "nav.privacy") },
] as const;
const nodes = buildLandingNodes({
  locale,
  canonical,
  name: entry.data.title,
  description,
  breadcrumb: breadcrumbItems,
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  fullWidth={true}
  noSidebar={true}
  extraSchemaNodes={nodes}
>
  <article class="prose">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
  <style>
    .prose {
      max-width: 720px;
      margin-inline: auto;
    }
  </style>
</BaseLayout>
