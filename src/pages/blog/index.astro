---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import { getOrderedPosts, type PostWithMeta } from "~/lib/content/loader";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import {
  buildBlogNode,
  buildBreadcrumbsNode,
  buildWebPageNode,
  type GraphNode,
} from "~/lib/seo/schema";
import { landingOgPath } from "~/lib/og/landing-pages";
import { resolveTagLabel, getTagDict } from "~/lib/content/tags";
import { canonicalUrl } from "~/lib/seo/url-policy";
import { assignArtVariants } from "~/lib/content/card-art";
import { bareSlug } from "~/lib/content/slug";
import { BLOG_PAGE_SIZE } from "~/lib/content/blog-pagination";
import PostCard from "~/components/PostCard.astro";
import { applyPublicHtmlCache } from "~/lib/http/public-cache";

const locale = getLocaleFromPath(Astro.url.pathname);
const posts = await getOrderedPosts({ locale });
applyPublicHtmlCache(Astro.request, Astro.response.headers);
const allTags = Array.from(new Set(posts.flatMap((p: PostWithMeta) => p.entry.data.tags))).sort();
const blogHref = locale === "en" ? "/en/blog/" : "/blog/";
const courseHref =
  locale === "en" ? "/en/courses/claude-code-guide/" : "/courses/claude-code-guide/";
const homeHref = locale === "en" ? "/en/" : "/";
const gridVariants = assignArtVariants(posts.map((p: PostWithMeta) => bareSlug(p.entry.id)));
const initialPosts = posts.slice(0, BLOG_PAGE_SIZE);
const hasMore = posts.length > BLOG_PAGE_SIZE;
const partialBase = "/blog/partials/";
const blogNode = buildBlogNode(locale);
const tagsHrefBase = locale === "en" ? "/en/tags/" : "/tags/";
const dict = getTagDict(locale);

const canonical = canonicalUrl(Astro.url.pathname);
const homeAbs = canonicalUrl(homeHref);

const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "blog.title") },
] as const;

const breadcrumbsNode = buildBreadcrumbsNode({
  canonical,
  items: breadcrumbItems,
}) as GraphNode;

// Newest of pubDate/updatedDate across the listed posts — an edited post
// must bump the index's dateModified, not only a newly published one.
const latestModified = posts.reduce<Date | null>((acc, p) => {
  const d = p.entry.data.updatedDate ?? p.entry.data.pubDate;
  return acc && acc.getTime() > d.getTime() ? acc : d;
}, null);

const ogImagePath = landingOgPath("blog", locale);
const primaryImageOfPage = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

const webPageNode = buildWebPageNode({
  locale,
  canonical,
  name: t(locale, "blog.title"),
  description: t(locale, "blog.description"),
  type: "CollectionPage",
  dateModified: latestModified,
  breadcrumbId: `${canonical}#breadcrumbs`,
  primaryImageOfPage,
}) as GraphNode;
---

<BaseLayout
  title={t(locale, "meta.blog.title")}
  description={t(locale, "blog.description")}
  ogImage={ogImagePath}
  fullWidth={true}
  noSidebar={true}
  extraSchemaNodes={[blogNode, breadcrumbsNode, webPageNode]}
>
  <section class="list">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <header class="list__header">
      <p class="list__eyebrow">{t(locale, "blog.eyebrow")}</p>
      <h1 class="list__title">{t(locale, "blog.title")}</h1>
    </header>

    <a href={courseHref} class="list__course-banner">
      <span class="list__course-label">{t(locale, "blog.courseBannerLabel")}</span>
      <span class="list__course-title">{t(locale, "blog.courseBannerTitle")}</span>
      <span class="list__course-cta">{t(locale, "blog.courseBannerCta")}</span>
    </a>

    {
      allTags.length > 0 && (
        <nav class="list__tags" aria-label={t(locale, "blog.tagsAria")}>
          {allTags.map((tag: string) => (
            <a class="list__tag-chip" href={`${tagsHrefBase}${tag}/`}>
              #{resolveTagLabel(tag, locale, dict)}
            </a>
          ))}
        </nav>
      )
    }

    <ul class="list__grid" data-blog-grid>
      {
        initialPosts.map((p: PostWithMeta, i: number) => (
          <li>
            <PostCard
              entry={p.entry}
              href={`${blogHref}${bareSlug(p.entry.id)}/`}
              locale={locale}
              artVariant={gridVariants[i]}
              showDescription={true}
              headingLevel="h2"
              transitionName={`post-title-${bareSlug(p.entry.id)}`}
            />
          </li>
        ))
      }
    </ul>

    {
      hasMore && (
        <>
          <div
            class="list__sentinel"
            data-blog-sentinel
            data-next-page="2"
            data-partial-base={partialBase}
            data-announce="Загружены ещё статьи"
            aria-hidden="true"
          />
          <p class="list__status" data-blog-status role="status" aria-live="polite" />
        </>
      )
    }
  </section>

  <script>
    import { initLazyPostList } from "~/lib/posts/lazy-list";

    // astro:page-load fires on initial mount and after every View Transitions
    // navigation - same pattern as PostLayout's enhance script.
    document.addEventListener("astro:page-load", () => initLazyPostList(document));
  </script>

  <style>
    .list {
      max-width: 1080px;
      margin-inline: auto;
    }

    .list__header {
      margin-bottom: var(--space-6);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }
    .list__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-fg-subtle);
      margin: 0 0 var(--space-2) 0;
    }
    .list__title {
      font-family: var(--font-serif);
      font-size: var(--fs-3xl);
      font-weight: 500;
      margin: 0;
      color: var(--color-fg);
      letter-spacing: var(--tracking-tight);
    }
    .list__course-banner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: baseline;
      padding: var(--space-3) var(--space-4);
      margin-bottom: var(--space-5);
      border: 1px solid var(--color-accent);
      border-radius: var(--radius-md);
      background: var(--color-accent-subtle);
      text-decoration: none;
      transition: background var(--dur-fast) var(--ease-out);
    }
    .list__course-banner:hover {
      background: color-mix(in oklch, var(--color-accent), transparent 80%);
    }
    .list__course-label {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-accent);
      font-weight: 600;
    }
    .list__course-title {
      font-family: var(--font-serif);
      font-size: var(--fs-base);
      color: var(--color-fg);
      line-height: var(--lh-snug);
    }
    .list__course-cta {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--color-accent);
      white-space: nowrap;
    }
    @media (max-width: 600px) {
      .list__course-banner {
        grid-template-columns: 1fr;
        gap: var(--space-2);
      }
    }

    .list__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-6);
    }
    .list__tag-chip {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--color-fg-muted);
      padding: 2px 8px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      text-decoration: none;
      transition:
        border-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }
    .list__tag-chip:hover {
      border-color: var(--color-accent);
      color: var(--color-accent-hover);
    }
    .list__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
      list-style: none;
      padding: 0;
      margin: 0;
    }
    @media (max-width: 640px) {
      .list__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
    /* Lazy-loaded cards fade up into place; durations come from tokens,
       which collapse to 0ms under prefers-reduced-motion. */
    /* :global — lazily fetched <li> from the partial route carry no Astro
       scope attribute, so scoped selectors would never match them. */
    .list__grid > :global(li) {
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }
    .list__grid > :global(li.is-entering) {
      opacity: 0;
      transform: translateY(14px);
    }
    .list__sentinel {
      height: 1px;
    }
    /* Visually hidden live region announcing lazily loaded cards to AT. */
    .list__status {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  </style>
</BaseLayout>
