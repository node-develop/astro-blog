---
import "~/styles/content.css";
import { getEntry, render } from "astro:content";
import BookingWidget from "~/components/BookingWidget.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { landingOgPath } from "~/lib/og/landing-pages";
import { buildLandingNodes } from "~/lib/seo/landing";
import { canonicalUrl } from "~/lib/seo/url-policy";

const locale = getLocaleFromPath(Astro.url.pathname);
const entry = await getEntry("site", "contact");
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);

const canonical = canonicalUrl(Astro.url.pathname);
const homeAbs = new URL("/", Astro.site ?? Astro.url).toString();
// metaTitle / metaDescription are the search-result copy; title and
// description stay the page name and the human lede, so the <h1> and the
// schema keep reading the way the page reads.
const description =
  entry.data.metaDescription ??
  entry.data.description ??
  "Как связаться с автором artka.dev по техническим вопросам.";
const pageTitle = entry.data.metaTitle ?? entry.data.title;
const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "nav.contact") },
] as const;
const nodes = buildLandingNodes({
  locale,
  canonical,
  name: entry.data.title,
  description,
  breadcrumb: breadcrumbItems,
});
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={landingOgPath("contact", locale)}
  fullWidth={true}
  noSidebar={true}
  extraSchemaNodes={nodes}
>
  <article class="prose">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <h1>{entry.data.title}</h1>
    <Content />
    <BookingWidget locale={locale} />
  </article>
  <style>
    .prose {
      max-width: 720px;
      margin-inline: auto;
    }
  </style>
</BaseLayout>
