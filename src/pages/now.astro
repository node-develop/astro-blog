---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SiteSidebar from "~/components/SiteSidebar.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import { getEntry, render } from "astro:content";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";
import { buildLandingNodes } from "~/lib/seo/landing";
import { landingOgPath } from "~/lib/og/landing-pages";

const locale = getLocaleFromPath(Astro.url.pathname);
const entry = await getEntry("site", locale === "en" ? "en/now" : "now");
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const homeAbs = new URL(locale === "en" ? "/en/" : "/", Astro.site ?? Astro.url).toString();
const description = entry.data.description ?? "Current focus, updated monthly.";

const breadcrumbItems = [
  { name: t(locale, "nav.home"), href: homeAbs },
  { name: t(locale, "nav.now") },
] as const;

const ogImagePath = landingOgPath("now", locale);
const primaryImageOfPage = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

const nodes = buildLandingNodes({
  locale,
  canonical,
  name: entry.data.title,
  description,
  breadcrumb: breadcrumbItems,
  primaryImageOfPage,
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  ogImage={ogImagePath}
  fullWidth={true}
  extraSchemaNodes={nodes}
>
  <SiteSidebar slot="sidebar" />
  <article class="prose">
    <Breadcrumbs items={breadcrumbItems} ariaLabel={t(locale, "breadcrumbs.aria")} />
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
