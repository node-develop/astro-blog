---
/**
 * <CertificateButton course={courseSlug} totalLessons={N} />
 *
 * Renders a "Get certificate" button on the course landing page when
 * the user is signed in and has 100% progress. Hidden otherwise; the
 * progress meter handles the messaging.
 *
 * The button is a plain <a download> link to the certificate endpoint —
 * no JS required for the happy path. A small client script adds two
 * niceties:
 *   1. Hides itself if the user is signed out (data-auth flag).
 *   2. Live-updates visibility when the progress event fires (so it
 *      appears the moment the last lesson is completed without reload).
 *
 * Locale is read from the URL so the same component renders Russian
 * copy on /courses/* and English on /en/courses/*.
 */
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { t } from "~/i18n";

interface Props {
  course: string;
  totalLessons: number;
}
const { course, totalLessons } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const localePrefix = locale === "en" ? "/en" : "";
const copy = t(locale, "certificate.copy").replace("{count}", String(totalLessons));
const certificateHref = `${localePrefix}/courses/${course}/certificate.png`;
---

<div
  class="certificate"
  data-certificate-course={course}
  data-certificate-total={String(totalLessons)}
  hidden
>
  <p class="certificate__label">{t(locale, "certificate.label")}</p>
  <p class="certificate__copy">{copy}</p>
  <a class="certificate__cta" href={certificateHref} download={`${course}-certificate.png`}>
    {t(locale, "certificate.download")}
  </a>
</div>

<style>
  /* A finished course earns the lime band, the same close the article and
     the home page use. */
  .certificate {
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-6);
    border: var(--stroke-slab) solid var(--color-fg);
    background: var(--color-fill);
    color: var(--color-on-fill);
    box-shadow: var(--shadow-soft);
    border-radius: var(--radius-md);
  }
  .certificate__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-on-fill);
    font-weight: 700;
    margin: 0 0 var(--space-2) 0;
  }
  .certificate__copy {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-3) 0;
    color: var(--color-on-fill);
    text-wrap: pretty;
  }
  .certificate__cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    /* Same rule as the course band: on a fill, the band's ink, not the
       page's — otherwise this goes cream-on-lime in dark. */
    background: var(--color-on-fill);
    color: var(--color-fill);
    text-decoration: none;
    font-weight: 700;
    border: var(--stroke-bold) solid var(--color-on-fill);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .certificate__cta:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-on-fill);
  }
  .certificate__cta:active {
    transform: none;
    box-shadow: none;
  }
</style>

<script>
  import { getCourse, onProgressChange } from "~/lib/courses/progress";

  function update(el: HTMLElement): void {
    const slug = el.dataset.certificateCourse ?? "";
    const total = parseInt(el.dataset.certificateTotal ?? "0", 10);
    const signedIn = document.querySelector('body[data-auth="signed-in"]') !== null;
    const completed = getCourse(slug).completed.length;
    el.hidden = !(signedIn && total > 0 && completed >= total);
  }

  function init(): void {
    const els = document.querySelectorAll<HTMLElement>("[data-certificate-course]");
    els.forEach((el) => update(el));
    onProgressChange(() => els.forEach((el) => update(el)));
  }
  document.addEventListener("astro:page-load", init);
</script>
