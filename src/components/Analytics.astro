---
import GoogleAnalytics from "~/components/GoogleAnalytics.astro";

/**
 * Analytics — Plausible (self-hosted ready, DNT-aware) and, when `gaId` is
 * passed, Google Analytics 4.
 *
 * GA4 is emitted only in production builds. Its initial page view is queued
 * immediately; the library loads after window.load and an idle opportunity
 * so it does not compete with the first screen. Do Not Track prevents loading
 * and sets GA's documented opt-out flag `window["ga-disable-<ID>"]`.
 * Initialization is guarded across ClientRouter navigation; GA4 enhanced
 * measurement records subsequent page views from history changes.
 *
 * Usage in BaseLayout.astro <head>:
 *
 *   <Analytics
 *     domain="artka.dev"
 *     src="https://plausible.io/js/script.js"
 *   />
 *
 * For self-hosted Plausible, swap `src` to your instance:
 *   src="https://stats.artka.dev/js/script.js"
 *
 * Behaviour:
 *   - Skipped entirely if `navigator.doNotTrack === '1'`.
 *   - Skipped on localhost (Astro dev) so dev traffic doesn't pollute.
 *   - No cookies, no fingerprinting (Plausible default).
 *   - Loads `defer` so it never blocks the critical path.
 */
interface Props {
  domain: string;
  /** Plausible script URL. Default: hosted plausible.io */
  src?: string;
  /** GA4 measurement ID (G-XXXXXXX). Omit to skip Google Analytics. */
  gaId?: string;
}

const { domain, src = "https://plausible.io/js/script.js", gaId } = Astro.props;
const withGa = Boolean(gaId) && import.meta.env.PROD;
---

<script is:inline define:vars={{ domain, src }}>
  (function () {
    try {
      // Honor Do Not Track
      if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;

      // Skip on localhost / dev
      var host = window.location.hostname;
      if (host === "localhost" || host === "127.0.0.1" || host.endsWith(".local")) return;

      var s = document.createElement("script");
      s.defer = true;
      s.dataset.domain = domain;
      s.src = src;
      document.head.appendChild(s);
    } catch (e) {
      // Analytics failure must not break the page.
      console.warn("[analytics] init skipped:", e);
    }
  })();
</script>

{withGa && gaId && <GoogleAnalytics id={gaId} />}
