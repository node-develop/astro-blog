---
/**
 * <Tldr>: answer-first card. Phase 2 refresh — typographic, no card.
 *
 * Direction A: drop the box. Render TL;DR as a typographic block with a
 * mono uppercase eyebrow and a short sienna rule above. Reads as part of
 * the article, not as an interruption.
 *
 * Two ways to use:
 *   1. `<Tldr>В двух словах…</Tldr>` — slot contains MDX/markdown.
 *   2. `<Tldr text="…" />` — string prop (used by PostLayout's auto-render).
 */
interface Props {
  text?: string;
}

const { text } = Astro.props;
const hasSlot = Astro.slots.has("default");
const showCard = hasSlot || (typeof text === "string" && text.length > 0);
---

{
  showCard && (
    <aside class="tldr" aria-label="TL;DR">
      <p class="tldr__label">
        <span class="tldr__rule" aria-hidden="true" />
        TL;DR
      </p>
      {text && !hasSlot ? <p class="tldr__body">{text}</p> : <slot />}
    </aside>
  )
}

<style>
  /* Poster pass: the summary is a framed slab with a lime label tab notched
     into its top edge, not a hairline and an italic line. Unbounded ships
     weights only — no italic — so the old `font-style: italic` here asked
     the browser to synthesise an oblique of a display face, which smears at
     20px. The body takes the text face upright instead. */
  .tldr {
    position: relative;
    margin: var(--space-6) 0 var(--space-7);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: var(--stroke-slab) solid var(--color-fg);
    background: var(--color-bg-elevated);
  }
  .tldr__label {
    position: absolute;
    top: 0;
    left: var(--space-4);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    background: var(--color-fill);
    color: var(--color-on-fill);
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }
  /* The dash belonged to the hairline version; the tab replaces it. */
  .tldr__rule {
    display: none;
  }
  .tldr__body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--color-fg);
    font-weight: 500;
  }
  /* Slot variant: assume <p>/multi-paragraph; size them like __body. */
  .tldr :global(p) {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-sans);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--color-fg);
    font-weight: 500;
  }
  .tldr :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    .tldr__body,
    .tldr :global(p) {
      font-size: var(--fs-md);
    }
  }
</style>
