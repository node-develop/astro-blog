---
/**
 * <Tldr>: answer-first card. Phase 2 refresh — typographic, no card.
 *
 * Direction A: drop the box. Render TL;DR as a typographic block with a
 * mono uppercase eyebrow and a short sienna rule above. Reads as part of
 * the article, not as an interruption.
 *
 * Two ways to use:
 *   1. `<Tldr>В двух словах…</Tldr>` — slot contains MDX/markdown.
 *   2. `<Tldr text="…" />` — string prop (used by PostLayout's auto-render).
 */
interface Props {
  text?: string;
}

const { text } = Astro.props;
const hasSlot = Astro.slots.has("default");
const showCard = hasSlot || (typeof text === "string" && text.length > 0);
---

{
  showCard && (
    <aside class="tldr" aria-label="TL;DR">
      <p class="tldr__label">
        <span class="tldr__rule" aria-hidden="true" />
        TL;DR
      </p>
      {text && !hasSlot ? <p class="tldr__body">{text}</p> : <slot />}
    </aside>
  )
}

<style>
  .tldr {
    margin: 0 0 var(--space-7) 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .tldr__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    margin: 0 0 var(--space-3) 0;
  }
  .tldr__rule {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }
  .tldr__body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
    /* slight italic for editorial weight */
    font-style: italic;
    font-weight: 400;
  }
  /* Slot variant: assume <p>/multi-paragraph; size them like __body. */
  .tldr :global(p) {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--color-fg);
    font-style: italic;
  }
  .tldr :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    .tldr__body,
    .tldr :global(p) {
      font-size: var(--fs-md);
    }
  }
</style>
