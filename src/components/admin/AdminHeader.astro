---
import { auth } from "~/lib/auth";

const session = await auth.api.getSession({ headers: Astro.request.headers });
const user = session?.user ?? null;
---

<header class="admin-header" role="banner">
  <a href="/admin/posts/" class="admin-header__brand">
    <span>artka.dev</span>
    <span class="admin-header__divider" aria-hidden="true">/</span>
    <span class="admin-header__label">admin</span>
  </a>
  <nav class="admin-header__nav" aria-label="Admin">
    <a href="/admin/posts/">Статьи</a>
    <a href="/admin/site/">Страницы</a>
    <a href="/admin/media/">Медиа</a>
    <a href="/admin/translate/">Переводы</a>
    <a href="/admin/social/">Social</a>
    <a href="/" class="admin-header__out">На сайт ↗</a>
  </nav>
  <div class="admin-header__user">
    {user && <span class="admin-header__email">{user.email}</span>}
    <form method="POST" action="/api/auth/sign-out/">
      <button type="submit" class="admin-header__logout">Выйти</button>
    </form>
  </div>
</header>

<style>
  .admin-header {
    border-bottom: var(--stroke-slab) solid var(--color-fg);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-5);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .admin-header__brand {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--fs-base);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  .admin-header__label,
  .admin-header__divider {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  /* The one lime mark in the chrome: admin is a different room. */
  .admin-header__label {
    background: var(--color-fill);
    color: var(--color-on-fill);
    padding: 2px var(--space-2);
  }
  .admin-header__nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .admin-header__nav a {
    color: var(--color-fg-muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: var(--stroke-slab) solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .admin-header__nav a:hover {
    color: var(--color-fg);
    border-bottom-color: var(--color-fill);
  }
  .admin-header__out {
    color: var(--color-fg);
  }
  .admin-header__user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
  }
  .admin-header__logout {
    background: transparent;
    border: var(--stroke-bold) solid var(--color-fg);
    color: var(--color-fg);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .admin-header__logout:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-press);
  }
  .admin-header__logout:active {
    transform: none;
    box-shadow: none;
  }

  @media (max-width: 860px) {
    .admin-header {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .admin-header__nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      gap: var(--space-4);
      overflow-x: auto;
    }
    .admin-header__user {
      margin-left: auto;
    }
    .admin-header__email {
      display: none;
    }
  }
</style>
