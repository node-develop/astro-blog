---
/**
 * Rotating seal — the one continuous rotation in the poster system.
 *
 * Decorative: the phrase is repeated around a circle and carries no
 * information the page does not state in text, so the whole SVG is
 * aria-hidden. Content comes from home.md `sealPhrase`; an empty phrase
 * renders nothing.
 */
interface Props {
  phrase?: string | undefined;
  /** Outer diameter in px. 190 on desktop, 130 in tight spots. */
  size?: number | undefined;
}

const { phrase, size = 190 } = Astro.props;

// Repeat the phrase until it plausibly fills the circumference. One glyph of
// the label face at 11.5px with 0.24em tracking runs ~9px, so the circle
// (2πr, r = size * 0.38) takes about that many characters.
const circumference = 2 * Math.PI * (size * 0.38);
const perCopy = Math.max(1, phrase?.length ?? 0) * 9;
const copies = phrase ? Math.max(1, Math.min(4, Math.round(circumference / perCopy))) : 0;
const ring = phrase ? Array.from({ length: copies }, () => `${phrase} · `).join("") : "";
const half = size / 2;
const radius = size * 0.38;
const pathId = `seal-${Math.random().toString(36).slice(2, 8)}`;
---

{
  phrase && (
    <svg
      class="seal"
      viewBox={`0 0 ${size} ${size}`}
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <path
          id={pathId}
          d={`M${half},${half} m-${radius},0 a${radius},${radius} 0 1,1 ${radius * 2},0 a${radius},${radius} 0 1,1 -${radius * 2},0`}
        />
      </defs>
      <g class="seal__ring" style={`transform-origin:${half}px ${half}px`}>
        <text>
          <textPath href={`#${pathId}`} startOffset="0">
            {ring}
          </textPath>
        </text>
      </g>
      <circle class="seal__core" cx={half} cy={half} r={size * 0.23} />
      <text class="seal__arrow" x={half} y={half + size * 0.07} text-anchor="middle">
        &#8600;
      </text>
    </svg>
  )
}

<style>
  .seal {
    display: block;
  }
  .seal__ring {
    animation: seal-spin 18s linear infinite;
  }
  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .seal text {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.24em;
    fill: var(--color-fg);
  }
  .seal__core {
    fill: var(--color-fill-alt);
  }
  .seal__arrow {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 800;
    fill: var(--color-on-fill-alt);
  }
  @media (prefers-reduced-motion: reduce) {
    .seal__ring {
      animation: none;
    }
  }
</style>
