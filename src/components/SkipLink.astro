---
/**
 * Accessible skip-link. Visually hidden until focused, then pinned to
 * top-left so keyboard users can jump past the sidebar/header.
 */
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

const locale = getLocaleFromPath(Astro.url.pathname);
---

<a href="#main" class="skip-link">{t(locale, "skip.toContent")}</a>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: 100;
    background: var(--color-bg-elevated);
    color: var(--color-fg);
    padding: var(--space-2) var(--space-4);
    border: var(--stroke-bold) solid var(--color-fg);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    transform: translateY(-200%);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
</style>
