---
/**
 * RelatedPosts — surface 3 posts most similar to the current one.
 *
 * Algorithm: Jaccard tag overlap, tie-break by recency.
 * Excludes the current post + posts in another locale.
 *
 * Renders nothing if no candidates have any tag overlap.
 */
import { getRelatedPosts } from "~/lib/posts/related";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import type { Locale } from "~/i18n";

interface Props {
  currentSlug: string;
  locale?: Locale;
  limit?: number;
}

const { currentSlug, locale: forced, limit = 3 } = Astro.props;
const locale = forced ?? getLocaleFromPath(Astro.url.pathname);
const blogPrefix = locale === "en" ? "/en/blog" : "/blog";

const related = await getRelatedPosts({ slug: currentSlug, locale, limit });
const heading = locale === "en" ? "Related" : "Похожее";

const fmtDate = (d: Date): string =>
  new Intl.DateTimeFormat(locale === "en" ? "en-US" : "ru-RU", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(d);
---

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <header class="related__head">
        <span class="related__rule" aria-hidden="true" />
        <h2 id="related-heading" class="related__title">
          {heading}
        </h2>
      </header>
      <ul class="related__list">
        {related.map((p) => (
          <li class="related__item">
            <a href={`${blogPrefix}/${p.slug}/`} class="related__link">
              <p class="related__post-title">{p.title}</p>
              <p class="related__meta">
                <time datetime={p.pubDate.toISOString()}>{fmtDate(p.pubDate)}</time>
                {p.tags.length > 0 && (
                  <span class="related__tags"> · {p.tags.slice(0, 2).join(", ")}</span>
                )}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin: var(--space-7) 0 var(--space-6) 0;
  }
  .related__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  /* The hairline dash becomes a short lime slab: a fill, at slab weight. */
  .related__rule {
    width: 28px;
    height: var(--stroke-slab);
    background: var(--color-fill);
  }
  .related__title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg);
    margin: 0;
  }
  .related__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .related__link {
    display: block;
    padding: var(--space-4) 0 var(--space-3);
    border-top: var(--stroke-slab) solid var(--color-fg);
    text-decoration: none;
    color: var(--color-fg);
    transition:
      border-top-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .related__link:hover {
    border-top-color: var(--color-fill);
    transform: translateY(-2px);
  }
  .related__post-title {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2) 0;
    color: var(--color-fg);
    text-wrap: pretty;
  }
  .related__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
