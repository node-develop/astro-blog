---
import { getOrderedPosts, type PostWithMeta } from "~/lib/content/loader";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

interface Props {
  /** Slug of the currently-displayed post, if any — used for active highlight. */
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const posts = await getOrderedPosts({ locale });

// Split into "guide series" (numeric slugs) and "other" so the sidebar can
// group them visually — matches the structure of the existing content.
const NUMERIC_SLUG = /^\d{2}[-_]/;
const series = posts.filter((p: PostWithMeta) => NUMERIC_SLUG.test(p.entry.id));
const extras = posts.filter((p: PostWithMeta) => !NUMERIC_SLUG.test(p.entry.id));
---

<nav class="sidebar" aria-label={t(locale, "sidebar.aria")}>
  {
    series.length > 0 && (
      <section class="sidebar__section">
        <h2 class="sidebar__label">{t(locale, "sidebar.guide")}</h2>
        <ol class="sidebar__list" reversed={false}>
          {series.map((p: PostWithMeta) => {
            const isActive = p.entry.id === activeSlug;
            return (
              <li>
                <a
                  href={`/blog/${p.entry.id}`}
                  class="sidebar__link"
                  aria-current={isActive ? "page" : undefined}
                >
                  <span class="sidebar__num">{String(p.meta.order).padStart(2, "0")}</span>
                  <span class="sidebar__title">{p.entry.data.title}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }
  {
    extras.length > 0 && (
      <section class="sidebar__section">
        <h2 class="sidebar__label">{t(locale, "sidebar.other")}</h2>
        <ul class="sidebar__list">
          {extras.map((p: PostWithMeta) => (
            <li>
              <a
                href={`/blog/${p.entry.id}`}
                class="sidebar__link"
                aria-current={p.entry.id === activeSlug ? "page" : undefined}
              >
                <span class="sidebar__title">{p.entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</nav>

<style>
  .sidebar {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .sidebar__section + .sidebar__section {
    margin-top: var(--space-6);
  }
  .sidebar__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
    margin: 0 0 var(--space-3) 0;
    font-weight: 500;
  }
  .sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sidebar__link {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-fg-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .sidebar__link:hover {
    color: var(--color-fg);
    background: var(--color-bg-elevated);
  }
  .sidebar__link[aria-current="page"] {
    color: var(--color-fg);
    background: var(--color-accent-soft);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }
  .sidebar__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
    font-variant-numeric: tabular-nums;
  }
  .sidebar__link[aria-current="page"] .sidebar__num {
    color: var(--color-accent);
  }
  .sidebar__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
    word-break: normal;
    overflow-wrap: anywhere;
  }
</style>
