---
/**
 * Newsletter — Buttondown email signup.
 *
 * Configuration: set the form action to your Buttondown username:
 *   https://buttondown.email/api/emails/embed-subscribe/<username>
 *
 * Honeypot: hidden `<input name="hp" tabindex="-1">` traps bots.
 *
 * Layout: editorial single-column. On wide viewports, label sits to
 * the left of the input; on narrow, stacks.
 */
import { getLocaleFromPath } from "~/lib/i18n/routing";

interface Props {
  /** Buttondown username, e.g. "kashuta". */
  username?: string;
  /** Optional subtitle/blurb override. */
  blurb?: string;
}

const username = Astro.props.username ?? "kashuta";
const locale = getLocaleFromPath(Astro.url.pathname);
const labelEyebrow = locale === "en" ? "Newsletter" : "Рассылка";
const headline =
  locale === "en" ? "Notes from production, in your inbox." : "Заметки из production — на почту.";
const blurb =
  Astro.props.blurb ??
  (locale === "en"
    ? "One short letter every couple of weeks. New posts, work-in-progress, occasional code snippet. No spam, unsubscribe anytime."
    : "Одно короткое письмо раз в пару недель. Новые статьи, work-in-progress, иногда фрагменты кода. Без спама, отписаться в один клик.");
const placeholder = locale === "en" ? "you@example.com" : "you@example.com";
const cta = locale === "en" ? "Subscribe" : "Подписаться";
const note =
  locale === "en"
    ? "Hosted by Buttondown. No tracking pixels."
    : "На Buttondown. Без пикселей-трекеров.";

const action = `https://buttondown.email/api/emails/embed-subscribe/${username}`;
---

<section class="newsletter" aria-labelledby="newsletter-heading">
  <p class="newsletter__eyebrow">
    <span class="newsletter__rule" aria-hidden="true"></span>
    {labelEyebrow}
  </p>

  <h2 id="newsletter-heading" class="newsletter__headline">{headline}</h2>
  <p class="newsletter__blurb">{blurb}</p>

  <form
    class="newsletter__form"
    action={action}
    method="post"
    target="popupwindow"
    data-newsletter-form
  >
    <label class="newsletter__field">
      <span class="newsletter__label">Email</span>
      <input
        type="email"
        name="email"
        required
        placeholder={placeholder}
        autocomplete="email"
        class="newsletter__input"
      />
    </label>
    {/* Honeypot — keep hidden from real users + bots that fill all fields */}
    <input
      type="text"
      name="hp"
      class="newsletter__hp"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <input type="hidden" name="embed" value="1" />
    <button type="submit" class="newsletter__submit">{cta}</button>
  </form>

  <p class="newsletter__note">{note}</p>
</section>

<style>
  /* The article closes the way the home page does: a lime band, then the
     ink footer. It is the page's one conversion element, so it gets to be
     the loud object down here. */
  .newsletter {
    margin: var(--space-8) 0;
    padding: var(--space-6) var(--space-6) var(--space-5);
    background: var(--color-fill);
    color: var(--color-on-fill);
    border: var(--stroke-slab) solid var(--color-fg);
    box-shadow: var(--shadow-soft);
  }
  .newsletter__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-on-fill);
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
  }
  .newsletter__rule {
    width: 28px;
    height: var(--stroke-slab);
    background: var(--color-on-fill);
  }
  .newsletter__headline {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
    color: var(--color-on-fill);
    text-wrap: balance;
  }
  /* Body copy takes the text face: the display face is for the headline. */
  .newsletter__blurb {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-on-fill);
    margin: 0 0 var(--space-5) 0;
    max-width: 56ch;
    text-wrap: pretty;
  }
  .newsletter__form {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .newsletter__field {
    flex: 1 1 280px;
  }
  .newsletter__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .newsletter__input {
    width: 100%;
    background: var(--color-bg-elevated);
    border: var(--stroke-bold) solid var(--color-on-fill);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    color: var(--color-fg);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  /* The blue focus ring is invisible on lime; on this band the ring is ink. */
  .newsletter__input:focus {
    outline: var(--stroke-bold) solid var(--color-on-fill);
    outline-offset: 2px;
    border-color: var(--color-on-fill);
    box-shadow: none;
  }
  .newsletter__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  /* Same rule as the course band: on a fill, the band's ink, not the
     page's — otherwise this goes cream-on-lime in dark. */
  .newsletter__submit {
    background: var(--color-on-fill);
    color: var(--color-fill);
    border: var(--stroke-slab) solid var(--color-on-fill);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .newsletter__submit:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-on-fill);
  }
  .newsletter__submit:active {
    transform: none;
    box-shadow: none;
  }
  .newsletter__submit:focus-visible {
    outline: var(--stroke-bold) solid var(--color-on-fill);
    outline-offset: 2px;
  }
  .newsletter__note {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-on-fill);
    opacity: 0.72;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>

<script>
  // Block submissions where the honeypot field has a value.
  function initNewsletter(): void {
    document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";
      form.addEventListener("submit", (e: SubmitEvent) => {
        const hp = form.querySelector<HTMLInputElement>('input[name="hp"]');
        if (hp && hp.value !== "") {
          e.preventDefault();
          // Silent success-looking UI; bots get no signal.
          form.reset();
        }
      });
    });
  }
  document.addEventListener("astro:page-load", initNewsletter);
</script>
