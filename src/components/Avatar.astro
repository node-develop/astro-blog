---
/**
 * Avatar component.
 *
 * Renders the author photo at one of three semantic sizes:
 *   - sm:  32 × 32   — header lockup adjacent
 *   - md:  64 × 64   — about page sidebar
 *   - lg: 144 × 144  — about page hero
 *
 * Person.image (/public/avatar-512.png) stays the canonical raster for
 * Google's ≥112×112 Person.image requirement and the JSON feed, but the
 * markup below serves the pre-generated 64/128/288 WebP/AVIF ladder
 * (see public/AVATAR-README.md) so the browser never fetches the full
 * 228 KB PNG to paint a 32–144 px circle.
 *
 * No JS, just CSS for the framed-circle treatment.
 */
import { person } from "~/lib/seo/person";

interface Props {
  size?: "sm" | "md" | "lg";
  alt?: string;
  /** When true, renders inside a circular sienna ring frame. */
  framed?: boolean;
}

const { size = "md", alt = person.name, framed = true } = Astro.props;

const dim = size === "sm" ? 32 : size === "md" ? 64 : 144;
// On the lg variant we want a sharp render at 2× — browsers will pick
// the right dimension; the source is 512 px so this is well within range.
const eager = size === "lg";
const sizes = size === "lg" ? "144px" : size === "md" ? "64px" : "32px";
---

<figure class={`avatar avatar--${size}`} data-framed={framed ? "true" : undefined}>
  <picture>
    <source
      type="image/avif"
      srcset="/avatar-64.avif 64w, /avatar-128.avif 128w, /avatar-288.avif 288w"
      sizes={sizes}
    />
    <source
      type="image/webp"
      srcset="/avatar-64.webp 64w, /avatar-128.webp 128w, /avatar-288.webp 288w"
      sizes={sizes}
    />
    <img
      src="/avatar-128.webp"
      width={dim}
      height={dim}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="avatar__img"
    />
  </picture>
</figure>

<style>
  .avatar {
    margin: 0 0 var(--space-4) 0;
    display: inline-block;
    line-height: 0;
  }
  .avatar__img {
    border-radius: 50%;
    background: var(--color-bg-subtle);
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }
  .avatar--sm .avatar__img {
    width: 32px;
    height: 32px;
  }
  .avatar--md .avatar__img {
    width: 64px;
    height: 64px;
  }
  .avatar--lg .avatar__img {
    width: 144px;
    height: 144px;
  }

  .avatar[data-framed="true"] .avatar__img {
    box-shadow:
      0 0 0 1px var(--color-border),
      0 0 0 4px var(--color-bg),
      0 0 0 5px var(--color-accent);
  }

  /* On the about page, lg variant gets a small sienna underline beneath
     to anchor it visually to the H1 below. */
  .avatar--lg::after {
    content: "";
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    margin-top: var(--space-3);
  }
</style>
