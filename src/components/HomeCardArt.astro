---
/**
 * Decorative artwork block for home-page post cards (Variant A redesign).
 *
 * Post OG images carry the post title as text, so reusing them inside a
 * card that already shows the title would duplicate it. Instead each card
 * gets a small abstract stroke composition in the token palette. Purely
 * decorative — aria-hidden, colors from CSS custom properties so both
 * themes work without extra rules.
 *
 * `variant` picks one of four compositions; parents pass the card's
 * position so the row doesn't repeat a pattern.
 */
interface Props {
  variant: number;
}

const { variant } = Astro.props;
const v = ((variant % 4) + 4) % 4;
---

<div class="card-art" aria-hidden="true">
  {
    v === 0 && (
      <svg
        viewBox="0 0 420 260"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          d="M40 200 C 120 60, 200 60, 260 140 S 380 220, 400 120"
          stroke="var(--color-accent)"
          stroke-width="22"
          stroke-linecap="round"
          opacity="0.9"
        />
        <path
          d="M20 120 C 90 220, 210 230, 300 180"
          stroke="var(--color-border-strong)"
          stroke-width="12"
          stroke-linecap="round"
        />
        <circle cx="330" cy="70" r="26" fill="var(--color-accent)" opacity="0.25" />
        <rect
          x="60"
          y="40"
          width="44"
          height="44"
          rx="8"
          stroke="var(--color-fg-subtle)"
          stroke-width="3"
        />
      </svg>
    )
  }
  {
    v === 1 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <rect
          x="30"
          y="25"
          width="60"
          height="60"
          rx="10"
          stroke="var(--color-accent)"
          stroke-width="5"
        />
        <rect
          x="110"
          y="25"
          width="60"
          height="60"
          rx="30"
          fill="var(--color-accent)"
          opacity="0.25"
        />
        <line x1="90" y1="55" x2="110" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
      </svg>
    )
  }
  {
    v === 2 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <circle cx="100" cy="55" r="34" stroke="var(--color-accent)" stroke-width="5" />
        <circle cx="100" cy="55" r="6" fill="var(--color-accent)" />
        <line x1="100" y1="21" x2="100" y2="4" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="134" y1="55" x2="152" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="100" y1="89" x2="100" y2="106" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="66" y1="55" x2="48" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
      </svg>
    )
  }
  {
    v === 3 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          d="M30 85 L75 40 L110 70 L165 25"
          stroke="var(--color-accent)"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="165" cy="25" r="8" fill="var(--color-accent)" opacity="0.3" />
        <line
          x1="30"
          y1="95"
          x2="170"
          y2="95"
          stroke="var(--color-border-strong)"
          stroke-width="3"
        />
      </svg>
    )
  }
</div>

<style>
  .card-art {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg-subtle);
  }
  .card-art svg {
    width: 70%;
    height: 70%;
    max-width: 420px;
  }
</style>
