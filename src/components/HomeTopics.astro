---
/**
 * Topic filter bar on the home page (SEO-19, editorial redesign).
 *
 * A hairline-bounded navigation row right under the masthead: the top-N
 * tags (by post count) as mono-caps links, plus "all tags" on the right.
 * Anchored to /tags/<slug>/ archive routes, which already render with a
 * CollectionPage JSON-LD node and a visible breadcrumb.
 */
import { groupPostsByTag, resolveTagLabel, getTagDict } from "~/lib/content/tags";
import { getOrderedPosts } from "~/lib/content/loader";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

interface Props {
  /** Cap. Default 5 keeps the row tight and avoids tag-cloud drift. */
  limit?: number;
}

const { limit = 5 } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const posts = await getOrderedPosts({ locale });
const grouped = groupPostsByTag(posts);
const dict = getTagDict(locale);
const tagsHrefBase = locale === "en" ? "/en/tags/" : "/tags/";

const topTags = [...grouped.entries()]
  .map(([slug, items]) => ({
    slug,
    count: items.length,
    label: resolveTagLabel(slug, locale, dict),
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, limit);
---

{
  topTags.length > 0 && (
    <nav class="topics" aria-label={t(locale, "tags.title")}>
      <ul class="topics__list">
        {topTags.map((tag) => (
          <li>
            <a class="topics__link" href={`${tagsHrefBase}${tag.slug}/`}>
              {tag.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="topics__all-link" href={tagsHrefBase}>
        {t(locale, "footer.link.tags")} →
      </a>
    </nav>
  )
}

<style>
  /* Vertical rhythm is owned by the home page's flex column (gap);
     the bar spans the full editorial grid between two hairlines. */
  .topics {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: var(--stroke-bold) solid var(--color-fg);
    border-bottom: var(--stroke-bold) solid var(--color-fg);
    padding: var(--space-4) var(--space-1);
  }
  .topics__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .topics__link {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: var(--space-1) 0;
    /* Reserved up front so a hover never nudges the row. */
    border-bottom: var(--stroke-slab) solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .topics__link:hover {
    color: var(--color-fg);
    border-bottom-color: var(--color-fill);
  }
  .topics__all-link {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg);
    text-decoration: none;
    border-bottom: var(--stroke-slab) solid var(--color-fill);
    padding-bottom: 1px;
  }
  .topics__all-link:hover {
    border-bottom-color: var(--color-fg);
  }
</style>
