---
/**
 * Course promo band on the home page (Variant A redesign).
 *
 * Horizontal accent band: eyebrow + serif title + lede on the left,
 * solid CTA button on the right. Content comes from home.md frontmatter.
 */
interface Props {
  eyebrow?: string | undefined;
  title?: string | undefined;
  lede?: string | undefined;
  cta?: string | undefined;
  href: string;
}

const { eyebrow, title, lede, cta, href } = Astro.props;
---

<aside class="course-band">
  <div class="course-band__body">
    {eyebrow && <p class="course-band__eyebrow">{eyebrow}</p>}
    <h2 class="course-band__title">
      <a href={href}>{title}</a>
    </h2>
    {lede && <p class="course-band__lede">{lede}</p>}
  </div>
  {
    cta && (
      <a href={href} class="course-band__cta">
        {cta}
      </a>
    )
  }
</aside>

<style>
  .course-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    /* The closing lime band. One per page, and the home page spends it here. */
    border: var(--stroke-slab) solid var(--color-fg);
    background: var(--color-fill);
    color: var(--color-on-fill);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-6) var(--space-7);
  }
  .course-band__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 720px;
  }
  .course-band__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-weight: 700;
    color: var(--color-on-fill);
    margin: 0;
  }
  .course-band__title {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin: 0;
  }
  .course-band__title a {
    color: var(--color-on-fill);
    text-decoration: none;
  }
  .course-band__lede {
    color: var(--color-on-fill);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    margin: 0;
    text-wrap: pretty;
  }
  /* A button standing ON a fill band takes that band's own ink pair, not
     the page's. --color-fg / --color-bg invert with the theme, so in dark
     this was a cream button on lime — a hole punched in the band. The
     fill/on-fill pair belongs to the band and does not flip. */
  .course-band__cta {
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-base);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-fill);
    background: var(--color-on-fill);
    border: var(--stroke-slab) solid var(--color-on-fill);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  /* On hover it opens up: the ink drains out, the frame stays, and the
     shadow is ink on lime — the only value that reads on this band. */
  .course-band__cta:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-on-fill);
  }
  .course-band__cta:active {
    transform: none;
    box-shadow: none;
  }
  @media (max-width: 768px) {
    .course-band {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-5);
    }
  }
</style>
