---
/**
 * Course promo band on the home page (Variant A redesign).
 *
 * Horizontal accent band: eyebrow + serif title + lede on the left,
 * solid CTA button on the right. Content comes from home.md frontmatter.
 */
interface Props {
  eyebrow?: string | undefined;
  title?: string | undefined;
  lede?: string | undefined;
  cta?: string | undefined;
  href: string;
}

const { eyebrow, title, lede, cta, href } = Astro.props;
---

<aside class="course-band">
  <div class="course-band__body">
    {eyebrow && <p class="course-band__eyebrow">{eyebrow}</p>}
    <h2 class="course-band__title">
      <a href={href}>{title}</a>
    </h2>
    {lede && <p class="course-band__lede">{lede}</p>}
  </div>
  {
    cta && (
      <a href={href} class="course-band__cta">
        {cta}
      </a>
    )
  }
</aside>

<style>
  .course-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    border: 1px solid var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-7);
  }
  .course-band__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 720px;
  }
  .course-band__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    margin: 0;
  }
  .course-band__title {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .course-band__title a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .course-band__title a:hover {
    color: var(--color-accent);
  }
  .course-band__lede {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    margin: 0;
    text-wrap: pretty;
  }
  .course-band__cta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-bg);
    background: var(--color-accent);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .course-band__cta:hover {
    background: var(--color-accent-hover);
  }
  @media (max-width: 768px) {
    .course-band {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-5);
    }
  }
</style>
