---
/**
 * PrevNext — paginated navigation between posts.
 *
 * Behaviour:
 *   - Series posts (NN-prefixed slug): linked to neighbouring series posts
 *     by `meta.order`.
 *   - Other posts: linked by reverse-chronological pubDate.
 *
 * Renders nothing if neither prev nor next exists.
 */
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";
import { getPrevNext, type NeighbourPost } from "~/lib/posts/prev-next";
import type { Locale } from "~/i18n";

interface Props {
  currentSlug: string;
  locale: Locale;
}

const { currentSlug, locale: forcedLocale } = Astro.props;
const locale = forcedLocale ?? getLocaleFromPath(Astro.url.pathname);
const { prev, next } = await getPrevNext({ slug: currentSlug, locale });
const blogPrefix = locale === "en" ? "/en/blog" : "/blog";

const linkFor = (n: NeighbourPost): string => `${blogPrefix}/${n.slug}/`;
const labelPrev = locale === "en" ? "Previous" : "Предыдущая";
const labelNext = locale === "en" ? "Next" : "Следующая";
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label={t(locale, "post.related")}>
      {prev ? (
        <a href={linkFor(prev)} class="prevnext__link prevnext__link--prev" rel="prev">
          <span class="prevnext__label">
            <span class="prevnext__arrow" aria-hidden="true">
              ←
            </span>{" "}
            {labelPrev}
          </span>
          <span class="prevnext__title">{prev.title}</span>
        </a>
      ) : (
        <span class="prevnext__placeholder" aria-hidden="true" />
      )}
      {next ? (
        <a href={linkFor(next)} class="prevnext__link prevnext__link--next" rel="next">
          <span class="prevnext__label">
            {labelNext}{" "}
            <span class="prevnext__arrow" aria-hidden="true">
              →
            </span>
          </span>
          <span class="prevnext__title">{next.title}</span>
        </a>
      ) : (
        <span class="prevnext__placeholder" aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin: var(--space-8) 0 var(--space-6) 0;
    padding-top: var(--space-6);
    border-top: var(--stroke-bold) solid var(--color-fg);
  }
  .prevnext__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: var(--stroke-slab) solid var(--color-fg);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--color-fg);
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  /* Same hover as every other slab in the system: step out, grow the offset. */
  .prevnext__link:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-lifted);
  }
  .prevnext__link:active {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-press);
  }
  .prevnext__link--prev {
    align-items: flex-start;
    text-align: left;
  }
  .prevnext__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .prevnext__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-muted);
  }
  .prevnext__arrow {
    transition: transform var(--dur-fast) var(--ease-out);
    display: inline-block;
  }
  .prevnext__link--prev:hover .prevnext__arrow {
    transform: translateX(-2px);
  }
  .prevnext__link--next:hover .prevnext__arrow {
    transform: translateX(2px);
  }
  .prevnext__title {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    color: var(--color-fg);
  }
  .prevnext__placeholder {
    /* keeps grid 1fr/1fr balance when only one side exists */
  }
  @media (max-width: 600px) {
    .prevnext {
      grid-template-columns: 1fr;
    }
    .prevnext__link--next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
