---
/**
 * Site header with title, primary nav, language toggle, and the mobile drawer trigger.
 * The trigger is a `<button>` controlling the drawer via a custom event;
 * the drawer itself lives in MobileDrawer.astro (added in Task 13).
 */
import LangToggle from "./LangToggle.astro";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);

// For active-state matching, compare against the locale-stripped path so /en/blog still matches /blog
const localPath = locale === "en" ? pathname.replace(/^\/en/, "") || "/" : pathname;
const isActive = (prefix: string): boolean =>
  prefix === "/" ? localPath === "/" : localPath.startsWith(prefix);

const homeHref = locale === "en" ? "/en/" : "/";
const blogHref = locale === "en" ? "/en/blog" : "/blog";
const aboutHref = locale === "en" ? "/en/about" : "/about";
const nowHref = locale === "en" ? "/en/now" : "/now";
const usesHref = locale === "en" ? "/en/uses" : "/uses";
const projectsHref = locale === "en" ? "/en/projects" : "/projects";
---

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__brand" aria-label={t(locale, "nav.posts")}>
      <span class="site-header__label">{t(locale, "nav.posts")}</span>
      <span class="site-header__dot" aria-hidden="true">·</span>
      <span class="site-header__author">artka.dev</span>
    </a>

    <nav class="site-header__nav" aria-label={t(locale, "nav.posts")}>
      <a href={blogHref} aria-current={isActive("/blog") ? "page" : undefined}
        >{t(locale, "nav.posts")}</a
      >
      <a href={aboutHref} aria-current={isActive("/about") ? "page" : undefined}
        >{t(locale, "nav.about")}</a
      >
      <a href={nowHref} aria-current={isActive("/now") ? "page" : undefined}
        >{t(locale, "nav.now")}</a
      >
      <a href={usesHref} aria-current={isActive("/uses") ? "page" : undefined}
        >{t(locale, "nav.uses")}</a
      >
      <a href={projectsHref} aria-current={isActive("/projects") ? "page" : undefined}
        >{t(locale, "nav.projects")}</a
      >
    </nav>

    <LangToggle />

    <button
      type="button"
      class="site-header__search"
      aria-label={t(locale, "nav.search") + " (⌘K)"}
      onclick="window.dispatchEvent(new CustomEvent('astro-open-search'))"
    >
      <span aria-hidden="true">⌘K</span>
      <span class="visually-hidden">{t(locale, "nav.search")}</span>
    </button>

    <button
      type="button"
      class="site-header__drawer-btn"
      aria-label={t(locale, "drawer.openAria")}
      aria-controls="site-drawer"
      aria-expanded="false"
      data-drawer-trigger
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 6h16M4 12h16M4 18h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .site-header__brand {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .site-header__dot {
    color: var(--color-accent);
  }
  .site-header__author {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-fg-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .site-header__nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-5);
    font-size: var(--fs-sm);
  }
  .site-header__nav a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .site-header__nav a[aria-current="page"] {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-accent);
  }
  .site-header__nav a:hover {
    color: var(--color-fg);
  }

  .site-header__drawer-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: var(--color-fg);
    cursor: pointer;
  }

  .site-header__search {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    color: var(--color-fg-subtle);
    cursor: pointer;
    line-height: 1.4;
  }
  .site-header__search:hover {
    background: var(--color-bg-elevated);
    color: var(--color-fg);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1023px) {
    .site-header__drawer-btn {
      display: inline-flex;
    }
    .site-header__nav {
      /* Drawer takes over below 1024px — hide the inline nav so the
         brand + search + lang-toggle + drawer-btn don't overflow on
         narrow viewports (the drawer-btn opens a <dialog> with the same links). */
      display: none;
    }
  }
  @media (max-width: 768px) {
    .site-header__inner {
      padding: var(--space-3) var(--space-4);
      gap: var(--space-2);
    }
    .site-header__brand {
      font-size: var(--fs-base);
      gap: var(--space-1);
    }
  }
  @media (max-width: 480px) {
    .site-header__dot,
    .site-header__author {
      display: none;
    }
    .site-header__search [aria-hidden="true"] {
      display: none;
    }
  }
</style>
