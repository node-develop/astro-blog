---
/**
 * Site header — Phase 1 refresh (Direction A: Refined Editorial).
 *
 * Changes from previous version:
 *   - Lockup migrated from serif → mono (editorial-technical signature)
 *   - "notes from production" tagline added under brand
 *   - Active nav link: 1px sienna underline (was bottom-border block)
 *   - ThemeToggle inserted between LangToggle and ⌘K
 *   - Subtle hairline appears only after scroll (data-scrolled)
 *
 * Untouched: i18n routing, drawer trigger, search dispatch, aria contracts.
 */
import LangToggle from "./LangToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);

// For active-state matching, compare against the locale-stripped path so /en/blog still matches /blog
const localPath = locale === "en" ? pathname.replace(/^\/en/, "") || "/" : pathname;
const isActive = (prefix: string): boolean =>
  prefix === "/" ? localPath === "/" : localPath.startsWith(prefix);

const homeHref = locale === "en" ? "/en/" : "/";
const blogHref = locale === "en" ? "/en/blog/" : "/blog/";
const aboutHref = locale === "en" ? "/en/about/" : "/about/";
const nowHref = locale === "en" ? "/en/now/" : "/now/";
const usesHref = locale === "en" ? "/en/uses/" : "/uses/";
const projectsHref = locale === "en" ? "/en/projects/" : "/projects/";

const tagline = locale === "en" ? "notes from production" : "записки из продакшна";
---

<header class="site-header" role="banner" data-site-header>
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__brand" aria-label={t(locale, "nav.home")}>
      <span class="site-header__lockup">artka.dev</span>
      <span class="site-header__tagline">{tagline}</span>
    </a>

    <nav class="site-header__nav" aria-label={t(locale, "nav.primary")}>
      <a href={blogHref} aria-current={isActive("/blog") ? "page" : undefined}
        >{t(locale, "nav.posts")}</a
      >
      <a href={aboutHref} aria-current={isActive("/about") ? "page" : undefined}
        >{t(locale, "nav.about")}</a
      >
      <a href={nowHref} aria-current={isActive("/now") ? "page" : undefined}
        >{t(locale, "nav.now")}</a
      >
      <a href={usesHref} aria-current={isActive("/uses") ? "page" : undefined}
        >{t(locale, "nav.uses")}</a
      >
      <a href={projectsHref} aria-current={isActive("/projects") ? "page" : undefined}
        >{t(locale, "nav.projects")}</a
      >
    </nav>

    <div class="site-header__actions">
      <LangToggle />
      <ThemeToggle />
      <button
        type="button"
        class="site-header__search"
        aria-label={t(locale, "nav.search") + " (⌘K)"}
        onclick="window.dispatchEvent(new CustomEvent('search:open'))"
      >
        <span aria-hidden="true">⌘K</span>
        <span class="visually-hidden">{t(locale, "nav.search")}</span>
      </button>

      <button
        type="button"
        class="site-header__drawer-btn"
        aria-label={t(locale, "drawer.openAria")}
        aria-controls="site-drawer"
        aria-expanded="false"
        data-drawer-trigger
        onclick="window.dispatchEvent(new CustomEvent('mobile-drawer:toggle'))"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-border);
  }
  .site-header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  /* ── Lockup ─────────────────────────────────────────────── */
  .site-header__brand {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
    color: var(--color-fg);
  }
  .site-header__lockup {
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .site-header__tagline {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--color-fg-subtle);
    margin-top: 2px;
  }

  /* ── Nav ───────────────────────────────────────────────── */
  .site-header__nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-5);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
  }
  .site-header__nav a {
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: var(--space-1) 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a:hover {
    color: var(--color-fg);
  }
  .site-header__nav a[aria-current="page"] {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: var(--color-accent);
  }

  /* ── Actions cluster ───────────────────────────────────── */
  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__drawer-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: var(--color-fg);
    cursor: pointer;
  }

  .site-header__search {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    color: var(--color-fg-subtle);
    cursor: pointer;
    line-height: 1.4;
  }
  .site-header__search:hover {
    background: var(--color-bg-elevated);
    color: var(--color-fg);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Tablet / landscape mobile (768-1023px): keep the inline nav with tighter
     gaps; show the drawer button as a redundant alternative. */
  @media (max-width: 1023px) {
    .site-header__drawer-btn {
      display: inline-flex;
    }
    .site-header__nav {
      margin-left: auto;
      gap: var(--space-3);
      font-size: var(--fs-xs);
    }
  }
  /* Narrow mobile (≤767px): hide inline nav; drawer carries it. */
  @media (max-width: 767px) {
    .site-header__inner {
      padding: var(--space-3) var(--space-4);
      gap: var(--space-2);
    }
    .site-header__lockup {
      font-size: var(--fs-base);
    }
    .site-header__tagline {
      display: none;
    }
    .site-header__nav {
      display: none;
    }
  }
</style>

<script>
  function initHeaderScroll(): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header || header.dataset.scrollBound === "1") return;
    header.dataset.scrollBound = "1";

    const sync = (): void => {
      if (window.scrollY > 4) {
        header.setAttribute("data-scrolled", "");
      } else {
        header.removeAttribute("data-scrolled");
      }
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  }

  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
