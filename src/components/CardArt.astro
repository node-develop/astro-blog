---
/**
 * Decorative artwork block for post cards and article headers (poster
 * redesign).
 *
 * Post OG images carry the post title as text, so reusing them inside a
 * card that already shows the title would duplicate it. Instead each card
 * gets a small abstract stroke composition in the token palette. Purely
 * decorative — aria-hidden, colors from CSS custom properties so both
 * themes work without extra rules. Poster rules: corners are square, the
 * heavy strokes are ink, and the one washed accent shape per composition
 * becomes a solid lime plate — a fill, never a tint.
 *
 * Variant 0 is the large featured-slot composition (420×260, heavy
 * strokes) — pass it explicitly; it never comes out of a seed. Variants
 * 1..5 are the small-card pool. Pick one via `seed` (the post slug —
 * stable per article), via `variant` from `assignArtVariants()` when a
 * grid needs collision-free neighbours, or `variant` literal.
 */
import { pickArtVariant, SEEDED_VARIANT_COUNT } from "~/lib/content/card-art";

interface Props {
  variant?: number;
  seed?: string;
}

const { variant, seed } = Astro.props;
const raw = variant ?? (seed !== undefined ? pickArtVariant(seed) : 1);
const v = raw >= 0 && raw <= SEEDED_VARIANT_COUNT ? raw : 1;
---

<div class="card-art" aria-hidden="true">
  {
    v === 0 && (
      <svg
        viewBox="0 0 420 260"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          d="M40 200 C 120 60, 200 60, 260 140 S 380 220, 400 120"
          stroke="var(--color-accent)"
          stroke-width="22"
          stroke-linecap="round"
        />
        <path
          d="M20 120 C 90 220, 210 230, 300 180"
          stroke="var(--color-border-strong)"
          stroke-width="12"
          stroke-linecap="round"
        />
        <circle cx="330" cy="70" r="26" fill="var(--color-fill)" />
        <rect
          x="60"
          y="40"
          width="44"
          height="44"
          rx="0"
          stroke="var(--color-fg-subtle)"
          stroke-width="3"
        />
      </svg>
    )
  }
  {
    v === 1 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <rect
          x="30"
          y="25"
          width="60"
          height="60"
          rx="0"
          stroke="var(--color-accent)"
          stroke-width="5"
        />
        <rect x="110" y="25" width="60" height="60" rx="0" fill="var(--color-accent)" />
        <line x1="90" y1="55" x2="110" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
      </svg>
    )
  }
  {
    v === 2 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <circle cx="100" cy="55" r="34" stroke="var(--color-accent)" stroke-width="5" />
        <circle cx="100" cy="55" r="6" fill="var(--color-accent)" />
        <line x1="100" y1="21" x2="100" y2="4" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="134" y1="55" x2="152" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="100" y1="89" x2="100" y2="106" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line x1="66" y1="55" x2="48" y2="55" stroke="var(--color-fg-subtle)" stroke-width="4" />
      </svg>
    )
  }
  {
    v === 3 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          d="M30 85 L75 40 L110 70 L165 25"
          stroke="var(--color-accent)"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="165" cy="25" r="8" fill="var(--color-accent)" opacity="0.3" />
        <line
          x1="30"
          y1="95"
          x2="170"
          y2="95"
          stroke="var(--color-border-strong)"
          stroke-width="3"
        />
      </svg>
    )
  }
  {
    v === 4 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <rect
          x="42"
          y="58"
          width="16"
          height="32"
          rx="0"
          fill="var(--color-accent)"
          opacity="0.3"
        />
        <rect
          x="78"
          y="42"
          width="16"
          height="48"
          rx="0"
          stroke="var(--color-accent)"
          stroke-width="5"
        />
        <rect x="114" y="24" width="16" height="66" rx="0" fill="var(--color-accent)" />
        <circle cx="152" cy="30" r="7" stroke="var(--color-fg-subtle)" stroke-width="4" />
        <line
          x1="30"
          y1="96"
          x2="170"
          y2="96"
          stroke="var(--color-border-strong)"
          stroke-width="3"
        />
      </svg>
    )
  }
  {
    v === 5 && (
      <svg
        viewBox="0 0 200 110"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          d="M40 82 A 60 60 0 0 1 160 82"
          stroke="var(--color-accent)"
          stroke-width="5"
          stroke-linecap="round"
        />
        <circle cx="160" cy="82" r="7" fill="var(--color-accent)" />
        <circle cx="100" cy="22" r="10" fill="var(--color-fill)" />
        <rect
          x="34"
          y="76"
          width="12"
          height="12"
          rx="0"
          stroke="var(--color-fg-subtle)"
          stroke-width="4"
        />
      </svg>
    )
  }
</div>

<style>
  .card-art {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg-subtle);
    overflow: hidden;
  }
  .card-art svg {
    width: 78%;
    height: 78%;
    max-width: 420px;
  }
</style>
